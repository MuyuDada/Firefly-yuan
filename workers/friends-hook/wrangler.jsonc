{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firefly-friends-hook",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	// 自定义域：绑到 muyudada.dpdns.org 这个已托管在 Cloudflare 的域上，
	// 避开 *.workers.dev 在国内被 DNS 污染、必须挂代理才能访问的问题。
	"routes": [
		{
			"pattern": "friends-hook.muyudada.dpdns.org",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "FRIENDS_KV",
			"id": "f1def21c1578472abcd0691ca80ab953"
		}
	],
	"vars": {
		"SITE_URL": "https://muyudada.dpdns.org",
		"SITE_NAME": "Muyu の 小窝",
		"APPLY_PATH": "/friends/",
		"WALINE_SERVER": "https://comment.muyudada.dpdns.org",
		"VERIFY_COMMENT": "1",
		"BACKLINK_TIMEOUT_MS": "8000",
		// 站内表单：出题 + 直接提交，不走 Waline 评论
		"ENABLE_FORM": "1",
		"CAPTCHA_PER_DAY": "30",
		"APPLY_PER_DAY": "5"
	}
}

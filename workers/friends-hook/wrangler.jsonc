{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firefly-friends-hook",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "FRIENDS_KV",
			"id": "f1def21c1578472abcd0691ca80ab953"
		}
	],
	"vars": {
		"SITE_URL": "https://muyudada.dpdns.org",
		"SITE_NAME": "Muyu の 小窝",
		"APPLY_PATH": "/friends/",
		"WALINE_SERVER": "https://comment.muyudada.dpdns.org",
		"VERIFY_COMMENT": "1",
		"BACKLINK_TIMEOUT_MS": "8000"
	}
}

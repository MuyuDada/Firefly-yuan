# 文章 AI 摘要（构建时生成，见 scripts/generate-ai-summary.ts）
#
# 用途：`pnpm ai-summary` 遍历文章、调模型生成摘要，写进 src/data/ai-summary.json，
# 由文章页静态渲染。访客端不发起任何请求，所以这个 key 不会进入页面源码。
# 任何 OpenAI 兼容端点都能用，改 BASE_URL 即可：
#   DeepSeek   https://api.deepseek.com                          deepseek-chat
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4              glm-4-flash
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1 qwen-plus
#   OpenRouter https://openrouter.ai/api/v1                      openai/gpt-4o-mini
#
# 本地开发：填在 .env.local 里，脚本会自动读取。
# 部署：不需要配到平台环境变量——摘要是构建产物，跟着仓库走。
AI_SUMMARY_API_KEY=
AI_SUMMARY_BASE_URL=https://api.deepseek.com
AI_SUMMARY_MODEL=deepseek-chat

# 天气组件（UAPI）可选密钥
#
# 用途：访客（匿名）额度被限流返回 429 时，组件会用这个 key 兜底重试一次。
# 组件逻辑是「访客额度优先」——只有匿名请求真的被限流了才会消耗 key 额度。
#
# 重要：本站是静态站点。带 PUBLIC_ 前缀的变量会在构建时被内联进页面源码，
# 也就是说这个 key 会出现在 HTML 里（任何人都能在页面源码中看到）。
# 请务必使用可在 UAPI 控制台随时吊销、并设置过消费上限的 key。
#
# 本地开发：把本文件复制为 .env.local 再填值（.env.local 已被 .gitignore 忽略）。
# 部署配置：在部署平台的环境变量里设置，不要提交到仓库。

PUBLIC_UAPI_KEY=

# 高德地图 Web端(JS API) Key 与安全密钥（/places/ 足迹地图）
#
# 申请：https://console.amap.com/dev/key/app —— 服务平台选「Web端(JS API)」，
# 并在控制台为该 Key 配置域名白名单（本站域名 + 本地 localhost）。
# 注意：静态站点没有服务端，这两个值会内联进页面源码，白名单是唯一的防护手段。
#
# 本地开发：在 .env.local 里填
# 部署配置：在部署平台（Vercel / Cloudflare）的环境变量里设置
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_CODE=

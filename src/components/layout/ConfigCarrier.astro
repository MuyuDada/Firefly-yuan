---
import {
	backgroundWallpaper,
	colorSchemeConfig,
	siteConfig,
	textureConfig,
} from "@/config";
---

<!-- 全局配置载体 -->
<div
  id="config-carrier"
  data-hue={siteConfig.themeColor.hue}
  data-wallpaper-mode={backgroundWallpaper.mode}
  data-color-style={colorSchemeConfig.defaultStyle}
  data-color-spec={colorSchemeConfig.defaultSpec}
  data-texture-preset={textureConfig.defaultPreset}
  data-texture-opacity={textureConfig.defaultOpacity}
>
</div>

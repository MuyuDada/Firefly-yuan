---
// GitHub 贡献热力图
//
// 构建时从第三方 API 拉取（无需 Token）。接口一次返回全部年份，
// 这里筛出当前年份渲染成日历格子；拉取失败只影响本面板，不影响归档页其余部分。
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	username: string;
}

const { username } = Astro.props;

interface Contribution {
	date: string;
	count: number;
	level: number;
}

const currentYear = new Date().getFullYear();

let contributions: Contribution[] = [];
let totalCount = 0;
let loadFailed = false;

// 构建时拉取，带指数退避重试。
// 第三方接口在高频请求下会返回 429（限流），重试间隔逐次拉长即可自愈；
// 仍失败时返回 null，由调用方降级为一行提示，不影响归档页其余部分。
async function fetchContributions(): Promise<{
	contributions?: Contribution[];
	total?: Record<string, number>;
} | null> {
	const maxAttempts = 3;

	for (let attempt = 1; attempt <= maxAttempts; attempt++) {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), 20000);
		try {
			const response = await fetch(
				`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(username)}`,
				{ headers: { "User-Agent": "Mozilla/5.0" }, signal: controller.signal },
			);
			clearTimeout(timer);

			// 429 / 5xx 属于可重试的服务端状态，其余 4xx 直接放弃
			if (response.status === 429 || response.status >= 500) {
				throw new Error(`HTTP ${response.status}`);
			}
			if (!response.ok) {
				console.warn(
					`[GITHUB-HEATMAP] Giving up on HTTP ${response.status} (not retryable)`,
				);
				return null;
			}
			return await response.json();
		} catch (error) {
			clearTimeout(timer);
			if (attempt === maxAttempts) {
				console.warn("[GITHUB-HEATMAP] Failed to load contributions:", error);
				return null;
			}
			// 1.5s → 3s 退避，给限流窗口留出恢复时间
			await new Promise((resolve) => setTimeout(resolve, attempt * 1500));
		}
	}
	return null;
}

const data = await fetchContributions();

if (data) {
	const all = data.contributions ?? [];
	contributions = all.filter((c) => c.date.startsWith(String(currentYear)));
	totalCount =
		data.total?.[String(currentYear)] ??
		contributions.reduce((sum, c) => sum + c.count, 0);
} else {
	loadFailed = true;
}

// ── 按「周（周日起） × 7 天」组织格子 ──
interface Cell {
	date: string;
	count: number;
	level: number;
	hidden: boolean;
}

const weeks: Cell[][] = [];
let monthLabels: { label: string; startCol: number; span: number }[] = [];

if (!loadFailed && contributions.length > 0) {
	const byDate = new Map(contributions.map((c) => [c.date, c]));

	const first = new Date(`${contributions[0].date}T00:00:00`);
	const last = new Date(
		`${contributions[contributions.length - 1].date}T00:00:00`,
	);

	// 对齐到包含首日的那个周日
	const cursor = new Date(first);
	cursor.setDate(cursor.getDate() - cursor.getDay());

	while (cursor <= last) {
		const week: Cell[] = [];
		for (let d = 0; d < 7; d++) {
			const dateStr = `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, "0")}-${String(cursor.getDate()).padStart(2, "0")}`;
			const hit = byDate.get(dateStr);
			const before = cursor < first;
			const after = cursor > last;
			week.push({
				date: dateStr,
				count: hit?.count ?? 0,
				level: hit?.level ?? 0,
				hidden: before || after,
			});
			cursor.setDate(cursor.getDate() + 1);
		}
		weeks.push(week);
	}

	// 月份标签：记录每个月首次出现的列，按列跨度合并
	const monthStarts = new Map<number, { label: string; startCol: number }>();
	weeks.forEach((week, colIndex) => {
		for (const cell of week) {
			if (cell.hidden) continue;
			const month = Number(cell.date.slice(5, 7));
			if (!monthStarts.has(month)) {
				monthStarts.set(month, {
					label: String(month),
					startCol: colIndex + 1,
				});
			}
		}
	});
	const entries = [...monthStarts.entries()].sort((a, b) => a[0] - b[0]);
	monthLabels = entries.map(([, v], i) => ({
		label: v.label,
		startCol: v.startCol,
		span: (entries[i + 1]?.[1].startCol ?? weeks.length + 1) - v.startCol,
	}));
}

// 星期标签（周日起，与 GitHub 一致：只标一/三/五）
const dayLabels = ["", "一", "", "三", "", "五", ""];
---

<div class="github-heatmap">
  <div class="heatmap-section-title">
    <Icon name="mdi:github" class="text-base" />
    <span>{i18n(I18nKey.githubHeatmap)}</span>
    {
      !loadFailed && (
        <span class="heatmap-stats">
          {totalCount} {i18n(I18nKey.heatmapContributions)}
        </span>
      )
    }
  </div>

  {
    loadFailed ? (
      <div class="heatmap-error">{i18n(I18nKey.heatmapLoadFailed)}</div>
    ) : (
      <div class="heatmap-body">
        {/* 月份行与网格放在同一个滚动容器里，保证横向滚动时两者一起移动 */}
        <div class="heatmap-scroll">
          <div class="heatmap-months">
            {monthLabels.map((m) => (
              <span
                class="heatmap-month-label"
                style={`grid-column: ${m.startCol} / span ${m.span}`}
              >
                {m.label}
              </span>
            ))}
          </div>

          <div class="heatmap-grid-wrap">
            <div class="heatmap-days">
              {dayLabels.map((label) => (
                <span class="heatmap-day-label">{label}</span>
              ))}
            </div>

            <div class="heatmap-grid">
              {weeks.map((week) => (
                <div class="heatmap-week">
                  {week.map((cell) => (
                    <div
                      class:list={["heatmap-cell", "github-cell", `level-${cell.level}`]}
                      title={cell.hidden ? undefined : `${cell.date} · ${cell.count} commits`}
                      style={cell.hidden ? "visibility:hidden" : undefined}
                    />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="heatmap-legend">
          <span class="heatmap-legend-label">{i18n(I18nKey.heatmapLess)}</span>
          {[0, 1, 2, 3, 4].map((level) => (
            <div class:list={["heatmap-cell", "github-cell", `level-${level}`]} />
          ))}
          <span class="heatmap-legend-label">{i18n(I18nKey.heatmapMore)}</span>
        </div>
      </div>
    )
  }
</div>

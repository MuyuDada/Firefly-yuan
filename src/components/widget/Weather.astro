</style>

<script>
	(function () {
		const API_URL = "https://uapis.cn/api/v1/misc/weather?";

		const CACHE_KEY = "weather_data_cache";
		const CACHE_TTL = 30 * 60 * 1000;

		// UAPI 天气接口的响应字段（只列出本组件用到的部分）
		interface WeatherForecastDay {
			date?: string | null;
			week?: string | null;
			temp_max?: number | string | null;
			temp_min?: number | string | null;
			weather_day?: string | null;
			weather_night?: string | null;
			pop?: number | string | null;
			sunrise?: string | null;
			sunset?: string | null;
		}

		interface LifeIndex {
			level?: string | null;
			brief?: string | null;
			advice?: string | null;
		}

		interface HourlyForecastItem {
			time?: string | null;
			temperature?: number | string | null;
			weather?: string | null;
			pop?: number | string | null;
		}

		interface MinutelyPrecip {
			summary?: string | null;
			update_time?: string | null;
			data?: Array<{ time?: string; precip?: number; type?: string }>;
		}

		interface WeatherData {
			city?: string | null;
			district?: string | null;
			temperature?: number | string | null;
			weather?: string | null;
			weather_icon?: number | string | null;
			report_time?: string | null;
			wind_direction?: string | null;
			wind_power?: string | null;
			temp_max?: number | string | null;
			temp_min?: number | string | null;
			feels_like?: number | string | null;
			visibility?: number | string | null;
			pressure?: number | string | null;
			humidity?: number | string | null;
			uv?: number | string | null;
			precipitation?: number | string | null;
			cloud?: number | string | null;
			aqi?: number | string | null;
			aqi_category?: string | null;
			aqi_level?: number | string | null;
			air_pollutants?: Record<string, number | string | null | undefined>;
			forecast?: WeatherForecastDay[];
			hourly_forecast?: HourlyForecastItem[] | null;
			minutely_precip?: MinutelyPrecip | null;
			life_indices?: Record<string, LifeIndex> | null;
		}

		// Iconify 运行时只加载一次，加载中的 Promise 挂在 window 上供多处复用
		const iconifyWindow = window as Window & {
			__iconifyLoading?: Promise<void>;
		};

		// ✅ 修复：按需加载 Iconify 运行时（用于动态切换天气图标）
		function ensureIconifyLoaded(): Promise<void> {
			if (typeof customElements !== "undefined" && customElements.get("iconify-icon")) {
				return Promise.resolve();
			}
			if (iconifyWindow.__iconifyLoading) return iconifyWindow.__iconifyLoading;
			iconifyWindow.__iconifyLoading = new Promise<void>((resolve) => {
				const s = document.createElement("script");
				s.src = "https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js";
				s.onload = () => resolve();
				s.onerror = () => resolve(); // 加载失败也不阻塞其他逻辑
				document.head.appendChild(s);
			});
			return iconifyWindow.__iconifyLoading;
		}

		const cacheManager = {
			set: function (key: string, data: WeatherData) {
				try {
					localStorage.setItem(key, JSON.stringify({
						data: data,
						timestamp: Date.now()
					}));
				} catch {}
			},
			get: function (key: string): WeatherData | null {
				try {
					const raw = localStorage.getItem(key);
					if (!raw) return null;
					const parsed = JSON.parse(raw);
					if (!parsed || !parsed.data) return null;
					if (Date.now() - (parsed.timestamp || 0) > CACHE_TTL) {
						localStorage.removeItem(key);
						return null;
					}
					return parsed.data as WeatherData;
				} catch {
					return null;
				}
			},
			remove: function (key: string) {
				try { localStorage.removeItem(key); } catch {}
			}
		};

		// IP 自动定位模式下没有 adcode/city，同样要缓存：
		// 否则每次翻页都会重新打一次接口，更容易撞上限流（缓存按访客各自的 localStorage 存）
		function getCacheKey(adcode: string, city: string): string {
			if (adcode) return CACHE_KEY + "adcode_" + adcode;
			if (city) return CACHE_KEY + "city_" + city;
			return CACHE_KEY + "ip";
		}

		function fmt(value: unknown, suffix = "", fallback = "--"): string {
			if (value === null || value === undefined || value === "") return fallback;
			return `${value}${suffix}`;
		}

		// 当前容器配置的 UAPI key（为空表示只用访客额度）
		function getApiKey(container: HTMLElement): string {
			return (container && container.dataset.apiKey) || "";
		}

		// 单次请求：apiKey 为空走访客额度，非空走 key 额度
		async function requestWeather(
			adcode: string,
			city: string,
			extended: boolean,
			apiKey: string,
		): Promise<Response> {
			const params = new URLSearchParams();
			if (adcode) {
				params.set("adcode", adcode);
			} else if (city) {
				params.set("city", city);
			}
			if (extended) {
				params.set("extended", "true");
			}
			params.set("forecast", "true");
			// 分钟级降水（仅国内城市有效）与生活指数：字段缺失时前端自动隐藏
			params.set("minutely", "true");
			params.set("hourly", "true");
			params.set("indices", "true");

			const controller = new AbortController();
			const timer = setTimeout(() => controller.abort(), 8000);
			try {
				return await fetch(API_URL + params.toString(), {
					signal: controller.signal,
					headers: apiKey ? { "X-API-Key": apiKey } : undefined,
				});
			} catch (e) {
				if (e instanceof Error && e.name === "AbortError") {
					throw new Error("请求超时，请稍后重试");
				}
				throw e;
			} finally {
				clearTimeout(timer);
			}
		}

		// ✅ 访客额度优先：先用匿名请求；仅当访客额度被限流（429）且配置了 key 时，
		// 才带 key 重试一次，尽量不消耗 key 额度
		async function fetchWeather(
			adcode: string,
			city: string,
			extended: boolean,
			apiKey: string,
		): Promise<WeatherData> {
			let response = await requestWeather(adcode, city, extended, "");

			if (!response.ok && response.status === 429 && apiKey) {
				response = await requestWeather(adcode, city, extended, apiKey);
			}

			if (!response.ok) {
				if (response.status === 429) {
					throw new Error(
						apiKey ? "接口请求过于频繁，请稍后重试" : "访客额度已用完，请稍后重试"
					);
				}
				throw new Error(`请求失败: ${response.status}`);
			}

			const data = (await response.json()) as WeatherData;

			const cacheKey = getCacheKey(adcode, city);
			if (cacheKey) {
				cacheManager.set(cacheKey, data);
			}

			return data;
		}

		// 天气图标映射
		// 码值来源：https://uapis.cn/openapi.json 中 weather_icon 字段的 enum / enumLabels
		// uapis.cn 用的是和风天气「旧版」编码（共 443 个码值），不是新版 QWeather 编码：
		//   100s 晴/多云（150-153 为夜间）· 300s 雨 · 400s 雪 · 500s 雾/霾/沙尘
		//   800s 月相 · 900s 冷热 · 1001+ 各类预警 · 1201+ 水文地质 · 2000+ 国际预警
		const FALLBACK_WEATHER_ICON = "material-symbols:cloud";

		const weatherIcons: Record<string, string> = {
			// —— 晴 / 多云（白天） ——
			"100": "material-symbols:sunny",
			"101": "material-symbols:cloud",
			"102": "material-symbols:partly-cloudy-day",
			"103": "material-symbols:partly-cloudy-day",
			"104": "material-symbols:cloud",
			// —— 晴 / 多云（夜间） ——
			"150": "material-symbols:clear-night",
			"151": "material-symbols:partly-cloudy-night",
			"152": "material-symbols:partly-cloudy-night",
			"153": "material-symbols:partly-cloudy-night",
			// —— 雨 ——
			"300": "material-symbols:rainy",
			"301": "material-symbols:rainy-heavy",
			"302": "material-symbols:thunderstorm",
			"303": "material-symbols:thunderstorm",
			"304": "material-symbols:weather-hail",
			"305": "material-symbols:rainy-light",
			"306": "material-symbols:rainy",
			"307": "material-symbols:rainy-heavy",
			"308": "material-symbols:rainy-heavy",
			"309": "material-symbols:rainy-light",
			"310": "material-symbols:rainy-heavy",
			"311": "material-symbols:rainy-heavy",
			"312": "material-symbols:rainy-heavy",
			"313": "material-symbols:weather-mix",
			"314": "material-symbols:rainy-light",
			"315": "material-symbols:rainy",
			"316": "material-symbols:rainy-heavy",
			"317": "material-symbols:rainy-heavy",
			"318": "material-symbols:rainy-heavy",
			"350": "material-symbols:rainy",
			"351": "material-symbols:rainy-heavy",
			"399": "material-symbols:rainy",
			// —— 雪 / 雨夹雪 ——
			"400": "material-symbols:snowing",
			"401": "material-symbols:snowing",
			"402": "material-symbols:snowing-heavy",
			"403": "material-symbols:snowing-heavy",
			"404": "material-symbols:weather-mix",
			"405": "material-symbols:weather-mix",
			"406": "material-symbols:weather-mix",
			"407": "material-symbols:snowing",
			"408": "material-symbols:snowing",
			"409": "material-symbols:snowing-heavy",
			"410": "material-symbols:snowing-heavy",
			"456": "material-symbols:weather-mix",
			"457": "material-symbols:snowing",
			"499": "material-symbols:snowing",
			// —— 雾 / 霾 / 沙尘 ——
			"500": "material-symbols:foggy",
			"501": "material-symbols:foggy",
			"502": "material-symbols:foggy",
			"503": "material-symbols:storm",
			"504": "material-symbols:storm",
			"507": "material-symbols:storm",
			"508": "material-symbols:storm",
			"509": "material-symbols:foggy",
			"510": "material-symbols:foggy",
			"511": "material-symbols:foggy",
			"512": "material-symbols:foggy",
			"513": "material-symbols:foggy",
			"514": "material-symbols:foggy",
			"515": "material-symbols:foggy",
			// —— 月相 ——
			"800": "material-symbols:dark-mode",
			"801": "material-symbols:nightlight",
			"802": "material-symbols:nightlight",
			"803": "material-symbols:nightlight",
			"804": "material-symbols:brightness-1",
			"805": "material-symbols:nightlight",
			"806": "material-symbols:nightlight",
			"807": "material-symbols:nightlight",
			// —— 其他 ——
			"900": "material-symbols:mode-heat",
			"901": "material-symbols:severe-cold",
			"999": "material-symbols:help",
			// —— 常见预警（1001+） ——
			"1001": "material-symbols:cyclone",
			"1002": "material-symbols:tornado",
			"1003": "material-symbols:rainy-heavy",
			"1004": "material-symbols:snowing-heavy",
			"1005": "material-symbols:severe-cold",
			"1006": "material-symbols:air",
			"1007": "material-symbols:storm",
			"1008": "material-symbols:ac-unit",
			"1009": "material-symbols:mode-heat",
			"1010": "material-symbols:air",
			"1014": "material-symbols:thunderstorm",
			"1015": "material-symbols:ac-unit",
			"1016": "material-symbols:ac-unit",
			"1017": "material-symbols:foggy",
			"1019": "material-symbols:foggy",
			"1021": "material-symbols:ac-unit",
			"1022": "material-symbols:water-drop",
			"1025": "material-symbols:local-fire-department",
			"1027": "material-symbols:ac-unit",
			"1029": "material-symbols:masks",
			"1031": "material-symbols:thunderstorm",
			"1033": "material-symbols:snowing-heavy",
			"1036": "material-symbols:flood",
			"1037": "material-symbols:landslide",
			"1038": "material-symbols:rainy-heavy",
			"1040": "material-symbols:snowing-heavy",
			"1043": "material-symbols:thunderstorm",
			"1049": "material-symbols:cyclone",
			"1053": "material-symbols:foggy",
			"1063": "material-symbols:rainy-heavy",
			"1075": "material-symbols:flood",
			"1077": "material-symbols:local-fire-department",
			"1079": "material-symbols:agriculture",
			"1081": "material-symbols:ac-unit",
			// —— 水文 / 地质 ——
			"1247": "material-symbols:volcano",
			"1271": "material-symbols:masks",
			"1272": "material-symbols:masks",
			"1273": "material-symbols:masks",
			"1274": "material-symbols:masks"
		};

		// 预警类码值数量庞大（1001-2554），未逐个列举的按区间回退到同类图标
		function getWeatherAlertIcon(code: string | number): string | null {
			const n = Number(code);
			if (!Number.isFinite(n)) return null;
			if (n >= 1001 && n <= 1089) return "material-symbols:warning"; // 国内预警 / 气象指数
			if (n >= 1201 && n <= 1221) return "material-symbols:flood"; // 洪水 / 内涝 / 干旱
			if (n >= 1241 && n <= 1251) return "material-symbols:landslide"; // 地质灾害
			if (n >= 1601 && n <= 1805) return "material-symbols:warning"; // 港澳预警
			if (n >= 2000 && n <= 2999) return "material-symbols:warning"; // 国际预警
			if (n >= 1000) return "material-symbols:warning";
			return null;
		}

		// ✅ 修复：更稳健的图标解析（兼容字符串/数字/空值）
		function getWeatherIcon(weatherIcon: string | number | null | undefined): string {
			if (weatherIcon === null || weatherIcon === undefined) {
				return FALLBACK_WEATHER_ICON;
			}
			const key = String(weatherIcon).trim();
			if (!key) return FALLBACK_WEATHER_ICON;
			return weatherIcons[key] || getWeatherAlertIcon(key) || FALLBACK_WEATHER_ICON;
		}

		function updateUI(
			container: HTMLElement,
			data: WeatherData | null,
			error: string | null = null,
		): void {
			const loading = container.querySelector("[data-weather-loading]");
			const errorEl = container.querySelector("[data-weather-error]");
			const content = container.querySelector("[data-weather-content]");
			const errorMsg = container.querySelector("[data-error-message]");

			if (loading) loading.classList.add("weather-hidden");

			if (error) {
				if (errorEl) errorEl.classList.remove("weather-hidden");
				if (errorMsg) errorMsg.textContent = error;
				return;
			}

			if (!data) return;

			if (errorEl) errorEl.classList.add("weather-hidden");

			const setData = (selector: string, value: string): void => {
				const el = container.querySelector(selector);
				if (el) el.textContent = value;
			};

			setData("[data-city]", fmt(data.city));
			setData("[data-district]", fmt(data.district, "", ""));
			setData("[data-temperature]", fmt(data.temperature));
			setData("[data-weather]", fmt(data.weather));
			setData("[data-report-time]", fmt(data.report_time, "", ""));

			const windParts = [data.wind_direction, data.wind_power].filter(
				(v) => v !== null && v !== undefined && v !== ""
			);
			setData("[data-wind]", windParts.length ? windParts.join(" ") : "--");

			setData("[data-temp-max]", fmt(data.temp_max));
			setData("[data-temp-min]", fmt(data.temp_min));

			// ✅ 修复核心：改用 icon 属性（iconify-icon 运行时才会响应）
			const iconEl = container.querySelector("[data-weather-icon]");
			if (iconEl) {
				const iconName = getWeatherIcon(data.weather_icon);
				iconEl.setAttribute("icon", iconName);
			}

			const extendedSection = container.querySelector("[data-weather-extended]");
			if (extendedSection) {
				if (container.dataset.extended === "false") {
					extendedSection.classList.add("weather-hidden");
				} else {
					extendedSection.classList.remove("weather-hidden");

					const todayForecast = data.forecast && data.forecast.length > 0 ? data.forecast[0] : null;

					setData("[data-feels-like]", fmt(data.feels_like, "°C", "--°C"));
					setData("[data-visibility]", fmt(data.visibility, "km", "--km"));
					setData("[data-pressure]", fmt(data.pressure, "hPa", "--hPa"));
					setData("[data-humidity]", fmt(data.humidity, "%", "--%"));
					// 紫外线：官方顶层 uv 是 0-11 的强度数字，但接口目前不返回该字段；
					// 缺失时回落到生活指数里的等级文字（如「高」「适宜」）
					const uvLevel = String(data.life_indices?.uv?.level || "").trim();
					setData("[data-uv]", fmt(data.uv, "", uvLevel || "--"));
					setData("[data-precipitation]", fmt(data.precipitation, "mm", "--mm"));
					setData("[data-cloud]", fmt(data.cloud, "%", "--%"));
					// 接口不提供降水概率；改用分钟级预报（24 条 × 5 分钟）累计未来 2 小时降水量
					const minutely = Array.isArray(data.minutely_precip?.data) ? data.minutely_precip.data : [];
					const precip2h = minutely.reduce((sum, item) => {
						const v = Number(item?.precip);
						return Number.isFinite(v) ? sum + v : sum;
					}, 0);
					setData("[data-precip-2h]", minutely.length ? `${precip2h.toFixed(1)}mm` : "--mm");
					setData("[data-sunrise]", fmt(todayForecast?.sunrise, "", "--:--"));
					setData("[data-sunset]", fmt(todayForecast?.sunset, "", "--:--"));

					const aqiEl = container.querySelector("[data-aqi]");
					const aqiCategoryEl = container.querySelector("[data-aqi-category]");
					if (aqiEl) aqiEl.textContent = fmt(data.aqi);
					if (aqiCategoryEl) {
						aqiCategoryEl.textContent = fmt(data.aqi_category);
						aqiCategoryEl.className = "aqi-tag";
						const level = Number(data.aqi_level);
						if (level === 1) aqiCategoryEl.classList.add("aqi-good");
						else if (level === 2) aqiCategoryEl.classList.add("aqi-moderate");
						else if (level >= 3) aqiCategoryEl.classList.add("aqi-bad");
					}

					const pollutants = data.air_pollutants || {};
					["pm25", "pm10", "o3", "no2", "so2", "co"].forEach((key) => {
						setData(`[data-${key}]`, fmt(pollutants[key]));
					});
				}
			}

			renderMinutely(container, data);
			renderHourly(container, data);
			renderForecast(container, data);
			renderIndices(container, data);

			if (content) content.classList.remove("weather-hidden");
		}

		// 分钟级降水：只在真有降水时展示一句话
		function renderMinutely(container: HTMLElement, data: WeatherData): void {
			const bar = container.querySelector<HTMLElement>("[data-minutely-bar]");
			const textEl = container.querySelector<HTMLElement>("[data-minutely-summary]");
			if (!bar || !textEl) return;
			const summary = String(data.minutely_precip?.summary || "").trim();
			const noRain = !summary || /无降水|没有降水|暂无降水/.test(summary);
			if (noRain) {
				bar.classList.add("weather-hidden");
				return;
			}
			textEl.textContent = summary;
			bar.classList.remove("weather-hidden");
		}

		// 逐小时：横向滚动条，只挑关键信息（时间 / 图标 / 温度 / 降水概率）
		// 天气文字 → 图标 + 色调（色调类名与组件既有的 .icon-* 配色体系一致）
		const WEATHER_META_RULES: Array<[RegExp, string, string]> = [
			[/雷/, "thunderstorm", "thunder"],
			[/雨夹雪/, "weather-snowy-rainy", "snow"],
			[/雪/, "weather-snowy", "snow"],
			[/雨/, "rainy", "rain"],
			[/雾/, "foggy", "fog"],
			[/霾|沙尘|浮尘/, "haze", "fog"],
			[/阴/, "cloud", "cloud"],
			[/多云/, "partly-cloudy-day", "partly"],
			[/晴/, "wb-sunny", "sunny"],
		];

		function weatherMeta(weather: string): { icon: string; tone: string } {
			for (const [re, icon, tone] of WEATHER_META_RULES) {
				if (re.test(weather)) return { icon: "material-symbols:" + icon, tone };
			}
			return { icon: FALLBACK_WEATHER_ICON, tone: "cloud" };
		}

		function renderHourly(container: HTMLElement, data: WeatherData): void {
			const section = container.querySelector<HTMLElement>("[data-hourly-section]");
			const strip = container.querySelector<HTMLElement>("[data-hourly-strip]");
			if (!section || !strip) return;
			const hours = Array.isArray(data.hourly_forecast)
				? data.hourly_forecast.slice(0, 24)
				: [];
			if (!hours.length) {
				section.classList.add("weather-hidden");
				return;
			}
			const esc = (v: unknown) =>
				String(v ?? "").replace(/[&<>"]/g, (c) =>
					({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
				);
			strip.innerHTML = hours
				.map((h, index) => {
					const m = String(h.time || "").match(/[T ](\d{2}):/);
					const label = index === 0 ? "现在" : m ? `${m[1]}时` : "--";
					const temp =
						h.temperature === null || h.temperature === undefined
							? "--"
							: esc(h.temperature);
					const rawWeather = String(h.weather || "");
					const meta = weatherMeta(rawWeather);
					const weather = esc(rawWeather);
					const nowClass = index === 0 ? " is-now" : "";
					return `<div class="hourly-item${nowClass}" title="${label} ${weather} ${temp}°">
						<span class="hourly-time">${label}</span>
						<iconify-icon class="hourly-icon tone-${meta.tone}" icon="${meta.icon}"></iconify-icon>
						<span class="hourly-temp">${temp}°</span>
					</div>`;
				})
				.join("");
			section.classList.remove("weather-hidden");
		}

		// 未来 3 天：数据来自已请求的 forecast，不再额外请求
		function renderForecast(container: HTMLElement, data: WeatherData): void {
			const section = container.querySelector<HTMLElement>("[data-forecast-section]");
			const list = container.querySelector<HTMLElement>("[data-forecast-list]");
			if (!section || !list) return;
			const days = Array.isArray(data.forecast) ? data.forecast.slice(0, 3) : [];
			if (!days.length) {
				section.classList.add("weather-hidden");
				return;
			}
			const esc = (v: unknown) =>
				String(v ?? "").replace(/[&<>"]/g, (c) =>
					({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
				);
			list.innerHTML = days
				.map((d, i) => {
					const week = i === 0 ? "今天" : esc(d.week || d.date || "");
					const hi = d.temp_max === null || d.temp_max === undefined ? "--" : esc(d.temp_max);
					const lo = d.temp_min === null || d.temp_min === undefined ? "--" : esc(d.temp_min);
					const rawDay = String(d.weather_day || "");
					const meta = weatherMeta(rawDay);
					const desc = esc(rawDay);
					return `<div class="forecast-row">
						<span class="forecast-week">${week}</span>
						<span class="forecast-desc">
							<iconify-icon class="forecast-icon tone-${meta.tone}" icon="${meta.icon}"></iconify-icon>
							<span class="forecast-text">${desc}</span>
						</span>
						<span class="forecast-temp"><b class="forecast-hi">${hi}°</b><span class="forecast-lo">${lo}°</span></span>
					</div>`;
				})
				.join("");
			section.classList.remove("weather-hidden");
		}

		// 生活指数：只挑 4 项最常看的
		function renderIndices(container: HTMLElement, data: WeatherData): void {
			const section = container.querySelector<HTMLElement>("[data-indices-section]");
			const grid = container.querySelector<HTMLElement>("[data-indices-grid]");
			if (!section || !grid) return;
			// [键, 标签, 图标, 颜色]：配色沿用扩展区 .icon-* 色板
			const map: Array<[string, string, string, string]> = [
				["clothing", "穿衣", "apparel", "#f97316"],
				["umbrella", "雨伞", "umbrella", "#0ea5e9"],
				["exercise", "运动", "directions-run", "#22c55e"],
				["cold_risk", "感冒", "sick", "#ef4444"],
			];
			const esc = (v: unknown) =>
				String(v ?? "").replace(/[&<>"]/g, (c) =>
					({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
				);
			const items = map
				.map(([key, label, icon, color]) => {
					const item = data.life_indices?.[key];
					const level = String(item?.level || "").trim();
					if (!level) return "";
					const brief = String(item?.brief || "").trim();
					const tip = label + "：" + level + (brief ? " · " + brief : "");
					return [
						'<div class="extended-item" title="' + esc(tip) + '">',
						'<iconify-icon class="extended-icon" style="color:' + color + '" icon="material-symbols:' + icon + '"></iconify-icon>',
						'<div class="extended-content">',
						'<span class="extended-label dark:text-neutral-100">' + esc(label) + "</span>",
						'<span class="extended-value dark:text-neutral-100">' + esc(level) + "</span>",
						"</div></div>",
					].join("");
				})
				.filter(Boolean);
			if (!items.length) {
				section.classList.add("weather-hidden");
				return;
			}
			grid.innerHTML = items.join("");
			section.classList.remove("weather-hidden");
		}

		function initWidget(container: HTMLElement): void {
			if (container.dataset.weatherInited === "true") return;
			container.dataset.weatherInited = "true";

			const adcode = container.dataset.adcode || "";
			const city = container.dataset.city || "";
			const extended = container.dataset.extended === "true";
			const apiKey = getApiKey(container);
			const cacheKey = getCacheKey(adcode, city);

			const retryBtn = container.querySelector("[data-retry-btn]");
			const content = container.querySelector("[data-weather-content]");
			const loading = container.querySelector("[data-weather-loading]");
			const errorEl = container.querySelector("[data-weather-error]");

			let requestSeq = 0;

			async function loadWeather(forceRefresh = false): Promise<void> {
				const seq = ++requestSeq;

				const cached = !forceRefresh && cacheKey ? cacheManager.get(cacheKey) : null;

				if (cached) {
					updateUI(container, cached);
				} else {
					if (loading) loading.classList.remove("weather-hidden");
					if (errorEl) errorEl.classList.add("weather-hidden");
					if (content) content.classList.add("weather-hidden");
				}

				try {
					const data = await fetchWeather(adcode, city, extended, apiKey);
					if (seq !== requestSeq) return;
					updateUI(container, data);
				} catch (e) {
					if (seq !== requestSeq) return;
					if (!cached) {
						const message = e instanceof Error && e.message ? e.message : "获取天气信息失败";
						updateUI(container, null, message);
					}
				}
			}

			if (retryBtn) {
				retryBtn.addEventListener("click", () => {
					if (cacheKey) cacheManager.remove(cacheKey);
					loadWeather(true);
				});
			}

			// ✅ 修复：先确保 Iconify 运行时加载完成，再触发首次渲染，
			// 避免 icon 属性在自定义元素未升级前被设置而丢失
			ensureIconifyLoaded().then(() => {
				const schedule: (cb: () => void) => void =
					typeof window.requestIdleCallback === "function"
						? (cb) => window.requestIdleCallback(cb, { timeout: 2000 })
						: (cb) => setTimeout(cb, 300);
				schedule(() => loadWeather());
			});
		}

		document
			.querySelectorAll<HTMLElement>("[data-weather-init]")
			.forEach((el) => initWidget(el));
	})();
</script>
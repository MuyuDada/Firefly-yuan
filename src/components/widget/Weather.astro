		// 预警类码值数量庞大（1001-2554），未逐个列举的按区间回退到同类图标
		function getWeatherAlertIcon(code: string | number): string | null {
			const n = Number(code);
			if (!Number.isFinite(n)) return null;
			if (n >= 1001 && n <= 1089) return "material-symbols:warning"; // 国内预警 / 气象指数
			if (n >= 1201 && n <= 1221) return "material-symbols:flood"; // 洪水 / 内涝 / 干旱
			if (n >= 1241 && n <= 1251) return "material-symbols:landslide"; // 地质灾害
			if (n >= 1601 && n <= 1805) return "material-symbols:warning"; // 港澳预警
			if (n >= 2000 && n <= 2999) return "material-symbols:warning"; // 国际预警
			if (n >= 1000) return "material-symbols:warning";
			return null;
		}

		// ✅ 修复：更稳健的图标解析（兼容字符串/数字/空值）
		function getWeatherIcon(weatherIcon: string | number | null | undefined): string {
			if (weatherIcon === null || weatherIcon === undefined) {
				return FALLBACK_WEATHER_ICON;
			}
			const key = String(weatherIcon).trim();
			if (!key) return FALLBACK_WEATHER_ICON;
			return weatherIcons[key] || getWeatherAlertIcon(key) || FALLBACK_WEATHER_ICON;
		}

		function updateUI(container, data, error = null) {
			const loading = container.querySelector("[data-weather-loading]");
			const errorEl = container.querySelector("[data-weather-error]");
			const content = container.querySelector("[data-weather-content]");
			const errorMsg = container.querySelector("[data-error-message]");

			if (loading) loading.classList.add("weather-hidden");

			if (error) {
				if (errorEl) errorEl.classList.remove("weather-hidden");
				if (errorMsg) errorMsg.textContent = error;
				return;
			}

			if (!data) return;

			if (errorEl) errorEl.classList.add("weather-hidden");

			const setData = (selector, value) => {
				const el = container.querySelector(selector);
				if (el) el.textContent = value;
			};

			setData("[data-city]", fmt(data.city));
			setData("[data-district]", fmt(data.district, "", ""));
			setData("[data-temperature]", fmt(data.temperature));
			setData("[data-weather]", fmt(data.weather));
			setData("[data-report-time]", fmt(data.report_time, "", ""));

			const windParts = [data.wind_direction, data.wind_power].filter(
				(v) => v !== null && v !== undefined && v !== ""
			);
			setData("[data-wind]", windParts.length ? windParts.join(" ") : "--");

			setData("[data-temp-max]", fmt(data.temp_max));
			setData("[data-temp-min]", fmt(data.temp_min));

			// ✅ 修复核心：改用 icon 属性（iconify-icon 运行时才会响应）
			const iconEl = container.querySelector("[data-weather-icon]");
			if (iconEl) {
				const iconName = getWeatherIcon(data.weather_icon);
				iconEl.setAttribute("icon", iconName);
			}

			const extendedSection = container.querySelector("[data-weather-extended]");
			if (extendedSection) {
				if (container.dataset.extended === "false") {
					extendedSection.classList.add("weather-hidden");
				} else {
					extendedSection.classList.remove("weather-hidden");

					const todayForecast = data.forecast && data.forecast.length > 0 ? data.forecast[0] : null;

					setData("[data-feels-like]", fmt(data.feels_like, "°C", "--°C"));
					setData("[data-visibility]", fmt(data.visibility, "km", "--km"));
					setData("[data-pressure]", fmt(data.pressure, "hPa", "--hPa"));
					setData("[data-humidity]", fmt(data.humidity, "%", "--%"));
					setData("[data-uv]", fmt(data.uv));
					setData("[data-precipitation]", fmt(data.precipitation, "mm", "--mm"));
					setData("[data-cloud]", fmt(data.cloud, "%", "--%"));
					setData("[data-pop]", fmt(todayForecast?.pop, "%", "--%"));
					setData("[data-sunrise]", fmt(todayForecast?.sunrise, "", "--:--"));
					setData("[data-sunset]", fmt(todayForecast?.sunset, "", "--:--"));

					const aqiEl = container.querySelector("[data-aqi]");
					const aqiCategoryEl = container.querySelector("[data-aqi-category]");
					if (aqiEl) aqiEl.textContent = fmt(data.aqi);
					if (aqiCategoryEl) {
						aqiCategoryEl.textContent = fmt(data.aqi_category);
						aqiCategoryEl.className = "aqi-tag";
						const level = Number(data.aqi_level);
						if (level === 1) aqiCategoryEl.classList.add("aqi-good");
						else if (level === 2) aqiCategoryEl.classList.add("aqi-moderate");
						else if (level >= 3) aqiCategoryEl.classList.add("aqi-bad");
					}

					const pollutants = data.air_pollutants || {};
					["pm25", "pm10", "o3", "no2", "so2", "co"].forEach((key) => {
						setData(`[data-${key}]`, fmt(pollutants[key]));
					});
				}
			}

			if (content) content.classList.remove("weather-hidden");
		}

		function initWidget(container) {
			if (container.dataset.weatherInited === "true") return;
			container.dataset.weatherInited = "true";

			const adcode = container.dataset.adcode || "";
			const city = container.dataset.city || "";
			const extended = container.dataset.extended === "true";
			const apiKey = getApiKey(container);
			const cacheKey = getCacheKey(adcode, city);

			const retryBtn = container.querySelector("[data-retry-btn]");
			const content = container.querySelector("[data-weather-content]");
			const loading = container.querySelector("[data-weather-loading]");
			const errorEl = container.querySelector("[data-weather-error]");

			let requestSeq = 0;

			async function loadWeather(forceRefresh = false) {
				const seq = ++requestSeq;

				const cached = !forceRefresh && cacheKey ? cacheManager.get(cacheKey) : null;

				if (cached) {
					updateUI(container, cached);
				} else {
					if (loading) loading.classList.remove("weather-hidden");
					if (errorEl) errorEl.classList.add("weather-hidden");
					if (content) content.classList.add("weather-hidden");
				}

				try {
					const data = await fetchWeather(adcode, city, extended, apiKey);
					if (seq !== requestSeq) return;
					updateUI(container, data);
				} catch (e) {
					if (seq !== requestSeq) return;
					if (!cached) {
						updateUI(container, null, e.message || "获取天气信息失败");
					}
				}
			}

			if (retryBtn) {
				retryBtn.addEventListener("click", () => {
					if (cacheKey) cacheManager.remove(cacheKey);
					loadWeather(true);
				});
			}

			// ✅ 修复：先确保 Iconify 运行时加载完成，再触发首次渲染，
			// 避免 icon 属性在自定义元素未升级前被设置而丢失
			ensureIconifyLoaded().then(() => {
				const schedule = typeof window.requestIdleCallback === "function"
					? (cb) => window.requestIdleCallback(cb, { timeout: 2000 })
					: (cb) => setTimeout(cb, 300);
				schedule(() => loadWeather());
			});
		}

		document.querySelectorAll("[data-weather-init]").forEach((el) => initWidget(el));
	})();
</script>
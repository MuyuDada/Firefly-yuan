---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

// 头像后方的渐隐背景图：优先用配置里的 banner；
// 留空时由下面的脚本调用与「时间问候」同一个随机图接口，两张卡复用同一张图
const customBanner = profileConfig.banner
	? /^(https?:|data:|\/\/)/.test(profileConfig.banner)
		? profileConfig.banner
		: url(profileConfig.banner)
	: "";

// 卡片底部的「文章 / 标签 / 分类」三栏统计，数字与侧栏一致取自内容集合
const [posts, categories, tags] = await Promise.all([
	getSortedPosts(),
	getCategoryList(),
	getTagList(),
]);

const stats = [
	{ label: "文章", value: posts.length, href: "/archive/" },
	{ label: "标签", value: tags.length, href: "/tags/" },
	{ label: "分类", value: categories.length, href: "/categories/" },
];

// 主按钮：优先用配置里的 GitHub 链接（参考卡的「Github主页」），没有就回落到关于页
const githubLink = profileConfig.links.find(
	(item) => /github/i.test(item.name) || /github\.com/i.test(item.url),
);
const cta = githubLink
	? {
			href: githubLink.url,
			label: "Github主页",
			icon: githubLink.icon,
			external: true,
		}
	: {
			href: "/about/",
			label: "关于我",
			icon: "fa7-regular:address-card",
			external: false,
		};
---

<div class:list={["profile-glow", className]} style={style}>
  <span class="gc-glow" aria-hidden="true"></span>
  <div class="profile-glow-border" aria-hidden="true"></div>

  <div class="card-base profile-glow-face pf-card">
    <!-- 头像后方的渐隐背景图：与「时间问候」共用同一个随机图接口；
         配置了 profileConfig.banner 时直接用那张图，不再请求接口 -->
    <div
      class="pf-banner"
      aria-hidden="true"
      style={customBanner ? `--pf-banner: url("${customBanner}")` : undefined}
    >
    </div>

    <!-- 头像：圆形 + 渐变描边环，悬停时露出「关于我」图标 -->
    <a aria-label="Go to About Page" href={url("/about/")} class="pf-avatar">
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt="Profile Image of the Author"
        class="profile-avatar-image"
        loading="eager"
        fetchpriority="high"
        widths={[350]}
        sizes="350px"
        showOverlay={false}
      />
      <span class="pf-avatar-overlay" aria-hidden="true">
        <Icon name="fa7-regular:address-card" class="pf-avatar-icon" />
      </span>
    </a>

    <!-- 名字 / 签名 -->
    <div class="gc-name pf-name" title={profileConfig.name}>
      {profileConfig.name}
    </div>
    <div class="gc-bio pf-bio" title={profileConfig.bio}>
      {profileConfig.bio}
    </div>

    <!-- 文章 / 标签 / 分类 -->
    <div class="pf-stats">
      {
        stats.map((item) => (
          <a class="pf-stat" href={url(item.href)}>
            <span class="gc-bio pf-stat-label">{item.label}</span>
            <span class="gc-name pf-stat-num">{item.value}</span>
          </a>
        ))
      }
    </div>

    <!-- 主按钮：整宽胶囊 -->
    <a
      class="pf-btn"
      href={cta.external ? cta.href : url(cta.href)}
      target={cta.external ? "_blank" : undefined}
      rel={cta.external ? "noopener" : undefined}
    >
      <Icon name={cta.icon} class="pf-btn-icon" />
      <span>{cta.label}</span>
    </a>

    <!-- 社交链接：一行居中图标 -->
    <div class="pf-socials">
      {
        profileConfig.links.map((item) => {
          const linkClass = item.showName
            ? "gc-link pf-social pf-social--named"
            : "gc-link pf-social";
          if (item.url.startsWith("mailto:")) {
            const encodedEmail = encodeMailto(item.url);
            return (
              <a
                rel="me"
                aria-label={item.name}
                href="#"
                data-encoded-email={encodedEmail}
                onclick={MAILTO_ONCLICK_SCRIPT}
                class={linkClass}
              >
                <Icon name={item.icon} class="pf-social-icon" />
                {item.showName && <span class="pf-social-text">{item.name}</span>}
              </a>
            );
          }
          return (
            <a
              rel="me"
              aria-label={item.name}
              href={item.url.startsWith("/") ? url(item.url) : item.url}
              target="_blank"
              class={linkClass}
            >
              <Icon name={item.icon} class="pf-social-icon" />
              {item.showName && <span class="pf-social-text">{item.name}</span>}
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // 与「时间问候」同一个随机图接口，但各自独立取图（不共用同一张）
    const applyBanner = () => {
      document.querySelectorAll(".pf-banner").forEach((el) => {
        if (el.dataset.imageSet === "true") return;
        el.style.setProperty(
          "--pf-banner",
          `url("https://random-api.czl.net/pic/ecy?t=${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}")`,
        );
        el.dataset.imageSet = "true";
        el.classList.add("is-ready");
      });
    };
    applyBanner();
    document.addEventListener("swup:contentReplaced", applyBanner);
  })();
</script>

<style>
  /* ==========================================================================
     布局：纵向居中的名片卡
     头像 → 名字 → 签名 → 文章/标签/分类 → 整宽按钮 → 社交图标
     这一层只管"排布与尺寸"，下面那段霓虹特效只管光/边框/染色，两者互不改写。
     ========================================================================== */
  .pf-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.4rem 1rem 1.15rem;
    text-align: center;
  }
  /* 卡内除背景图以外的元素统一抬到它上面 */
  .pf-card > :not(.pf-banner) {
    position: relative;
    z-index: 1;
  }

  /* ── 头像后方的渐隐背景图 ───────────────────────────────── */
  .pf-banner {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    /* 高度到「头像下沿」为止：上边距 1.4rem + 头像 6.25rem，背景图尽量露全，只被头像压住中间那个圆 */
    height: calc(1.4rem + 6.25rem + 0.3rem);
    background-image: var(--pf-banner, none);
    background-repeat: no-repeat;
    background-position: center 16%;
    background-size: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 72%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 72%,
      transparent 100%
    );
  }
  .pf-banner.is-ready {
    opacity: 0.75;
  }
  :global(html.dark) .pf-banner.is-ready {
    opacity: 0.85;
  }

  /* ── 头像：圆形 + 渐变描边环 ─────────────────────────────── */
  .pf-avatar {
    position: relative;
    display: block;
    width: 6.25rem;
    height: 6.25rem;
    padding: 3px;
    border-radius: 50%;
    background: conic-gradient(
      from 210deg,
      var(--primary),
      color-mix(in oklab, var(--primary) 35%, #a78bfa),
      color-mix(in oklab, var(--primary) 35%, #f472b6),
      var(--primary)
    );
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pf-avatar:hover {
    transform: translateY(-2px) scale(1.02);
  }
  .pf-avatar:active {
    transform: scale(0.97);
  }
  .pf-avatar .profile-avatar-image {
    width: 100%;
    height: 100%;
    border: 2px solid var(--card-bg);
    border-radius: 50%;
  }
  /* 悬停遮罩：提示可点进关于页 */
  .pf-avatar-overlay {
    position: absolute;
    inset: 3px;
    z-index: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: rgb(0 0 0 / 0.38);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pf-avatar:hover .pf-avatar-overlay,
  .pf-avatar:focus-visible .pf-avatar-overlay {
    opacity: 1;
  }
  .pf-avatar-icon {
    width: 1.5rem;
    height: 1.5rem;
    transform: scale(0.85);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pf-avatar:hover .pf-avatar-icon {
    transform: scale(1);
  }

  /* ── 名字 / 签名 ─────────────────────────────────────────── */
  .pf-name {
    max-width: 100%;
    margin-top: 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pf-bio {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }

  /* ── 文章 / 标签 / 分类 ─────────────────────────────────── */
  .pf-stats {
    display: flex;
    align-items: stretch;
    width: 100%;
    margin-top: 1.05rem;
  }
  .pf-stat {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-width: 0;
    padding: 0.3rem 0;
    border-radius: 0.5rem;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }
  .pf-stat + .pf-stat {
    border-left: 1px solid var(--line-divider);
  }
  .pf-stat:hover {
    background: color-mix(in oklab, var(--primary) 8%, transparent);
    transform: translateY(-1px);
  }
  .pf-stat-label {
    font-size: 0.6875rem;
    line-height: 1.2;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }
  .pf-stat-num {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    color: var(--deep-text);
  }

  /* ── 主按钮 ─────────────────────────────────────────────── */
  .pf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    height: 2.45rem;
    margin-top: 1rem;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 18px -10px color-mix(in oklab, var(--primary) 90%, transparent);
    transition:
      transform 0.2s ease,
      filter 0.25s ease;
  }
  .pf-btn:hover {
    filter: brightness(1.08);
  }
  .pf-btn:active {
    transform: scale(0.97);
  }
  .pf-btn-icon {
    width: 1rem;
    height: 1rem;
  }

  /* ── 社交图标 ───────────────────────────────────────────── */
  .pf-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pf-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--deep-text) 6%, transparent);
    color: color-mix(in oklab, var(--deep-text) 70%, transparent);
    transition:
      transform 0.2s ease,
      background 0.25s ease,
      color 0.25s ease;
  }
  .pf-social:hover {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .pf-social:active {
    transform: scale(0.94);
  }
  .pf-social--named {
    width: auto;
    padding-inline: 0.7rem;
  }
  .pf-social-icon {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  .pf-social-text {
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* 深色模式下卡面被特效改成深色底：分割线、头像环内侧空隙要跟着变暗 */
  :global(html.dark) .pf-stat + .pf-stat {
    border-color: rgb(255 255 255 / 0.1);
  }
  :global(html.dark) .pf-avatar .profile-avatar-image {
    border-color: var(--gc-card-color);
  }
  /* 深色下 --primary 是浅色，实心填充+白字对比不足，改成同色系半透明底 */
  :global(html.dark) .pf-btn {
    background: color-mix(in oklab, var(--primary) 20%, transparent);
    color: var(--primary);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--primary) 38%, transparent),
      0 8px 18px -12px color-mix(in oklab, var(--primary) 90%, transparent);
  }
  /* 悬停时按钮文字/底色跟卡内其它文字一起被光晕染色（与 .gc-link 同参数） */
  :global(html.dark) .profile-glow:hover .pf-btn {
    background: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      30%,
      15%
    );
    color: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      100%,
      76%
    );
    box-shadow: inset 0 0 0 1px
      hsl(calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg) 100% 70% / 0.35);
  }

  /* ==========================================================================
     个人资料卡片 · 深色霓虹发光特效
     移植自 CodePen @LukyVj《Sharp & Glowing dark card》(YzOXepM)。
     - 所有自定义属性与 keyframes 加 gc- 前缀，避免与站点 --hue 等变量冲突；
     - 用本组件 scoped style 封装，只作用于 Profile，不污染全局、不影响其它 widget；
     - 只在深色模式（html.dark）生效，白天/浅色模式完全关闭，卡片沿用站点默认外观；
     - 尊重 prefers-reduced-motion。
     ========================================================================== */
  @property --gc-hue {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-rotate {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-bg-y {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-bg-x {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-glow-translate-y {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-bg-size {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-glow-opacity {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-glow-blur {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --gc-glow-scale {
    syntax: "<number>";
    inherits: true;
    initial-value: 2;
  }
  @property --gc-glow-radius {
    syntax: "<number>";
    inherits: true;
    initial-value: 2;
  }
  /* ── 默认（白天 / 浅色模式）：不启用霓虹特效 ──────────────────────────────
     站点深色模式由 <html class="dark"> 标识。所有霓虹规则都写在 html.dark 下，
     浅色模式下装饰层保持隐藏、卡面与文字沿用站点 card-base 的默认浅色外观。 */
  .gc-glow,
  .profile-glow-border {
    display: none;
  }

  /* ── 深色模式：完整霓虹特效 ─────────────────────────────────────────── */
  :global(html.dark) .profile-glow {
    /* 卡面底色跟随站点卡片变量，和侧栏其它卡片保持一致 */
    --gc-card-color: var(--card-bg);
    --gc-text-color: hsl(260deg 10% 78%);
    --gc-glow-rotate-unit: 1deg;
    --gc-border-width: 3px;
    --gc-bg-size: 1;
    --gc-hue: 0;
    --gc-hue-speed: 1;
    --gc-bg-x: 50;
    --gc-bg-y: 0;
    --gc-rotate: 0;
    --gc-animation-speed: 4s;
    --gc-interaction-speed: 0.55s;
    --gc-glow-blur: 6;
    --gc-glow-opacity: 1;
    --gc-glow-scale: 1.5;
    --gc-glow-radius: 100;
    --gc-glow-translate-y: -65;
    --gc-scale-factor: 1;

    position: relative;
    isolation: isolate;
    border-radius: var(--radius-large);

    /* 色相统一由父级驱动：边框、光晕、hover 文字共用同一个 --gc-hue，
       这样文字能被"染"成与光晕完全一致的色相（原版靠 darken 混合实现）。
       hover 时在下面暂停，色相与文字颜色一起冻结。 */
    animation: gc-hue-animation var(--gc-animation-speed) linear infinite;
  }
  :global(html.dark) .profile-glow:hover {
    animation-play-state: paused;
  }

  /* 卡片面：深色模式下固定深色，覆盖 card-base 的主题背景；overflow 保留以裁剪头像 */
  .profile-glow-face {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-large) !important;
  }
  :global(html.dark) .profile-glow-face {
    background: var(--gc-card-color) !important;
  }

  /* 文字走 --gc-text-color（默认灰白）。
     悬停：还原原版「文字被光晕染色」的效果——原版用 mix-blend-mode: darken，
     白色文字与下方光晕做 min() 混合后等于光晕的纯色 hsl(hue,100%,60%)，
     所以文字不是变白，而是变成当前色相的彩色并随光晕冻结。
     这里直接用同一套 --gc-hue 算出同样的颜色，避免 darken 把头像压黑。 */
  :global(html.dark) .gc-name,
  :global(html.dark) .gc-bio {
    color: var(--gc-text-color) !important;
  }
  :global(html.dark) .profile-glow:hover .gc-name,
  :global(html.dark) .profile-glow:hover .gc-bio {
    color: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      100%,
      65%
    ) !important;
  }

  /* 社交按钮：深色模式下改为深色半透明底 + 亮色图标，融入霓虹卡片 */
  :global(html.dark) .gc-link {
    background: hsl(260deg 20% 16%) !important;
    color: hsl(260deg 10% 88%) !important;
  }
  /* 卡片悬停时，图标与按钮底色一起被"染色"，跟随当前色相（与文字同步冻结） */
  :global(html.dark) .profile-glow:hover .gc-link {
    background: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      30%,
      15%
    ) !important;
    color: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      100%,
      72%
    ) !important;
  }
  :global(html.dark) .profile-glow:hover .gc-link:hover {
    background: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      55%,
      24%
    ) !important;
    color: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      100%,
      90%
    ) !important;
  }
  :global(html.dark) .profile-glow:hover .gc-link:active {
    background: hsl(
      calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg),
      60%,
      18%
    ) !important;
  }

  /* 彩色流动边框：绝对定位在卡片外围，只露出 --gc-border-width 的一圈 */
  :global(html.dark) .profile-glow-border {
    display: block;
    position: absolute;
    z-index: 1;
    inset: calc(var(--gc-border-width) * -1);
    border-radius: calc(var(--radius-large) + var(--gc-border-width));
    background: #292929
      radial-gradient(
        30% 30% at calc(var(--gc-bg-x) * 1%) calc(var(--gc-bg-y) * 1%),
        hsl(calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg), 100%, 90%)
          calc(0% * var(--gc-bg-size)),
        hsl(calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg), 100%, 80%)
          calc(20% * var(--gc-bg-size)),
        hsl(calc(var(--gc-hue) * var(--gc-hue-speed) * 1deg), 100%, 60%)
          calc(40% * var(--gc-bg-size)),
        transparent 100%
      );
    mix-blend-mode: color-burn;
    pointer-events: none;
    animation: gc-rotate-bg var(--gc-animation-speed) linear infinite;
    transition: --gc-bg-size var(--gc-interaction-speed) ease;
  }


---
import { commentConfig } from "@/config";
import "@/styles/components/waline.css";

interface Props {
	path: string;
}

// imageUpload 是本项目自定义的上传配置，不是 Waline 原生选项，
// 单独取出来传，免得它被当成未知字段塞进 init()
const { imageUpload, ...walineOptions } = commentConfig.waline ?? {};

const config = {
	...walineOptions,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "1000"],
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};

const imageOptions = {
	enabled: true,
	maxSizeMB: 10,
	maxSide: 1600,
	quality: 0.82,
	maxOutputKB: 300,
	...(imageUpload ?? {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config, imageOptions }}>
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';

    /* ── 图片上传 ─────────────────────────────────────────────────
       Waline 默认把图片转成 base64 直接写进正文，而 wordLimit 统计的是
       「词数」：base64 里的 + / 会把长串切碎，128KB 的图就算出 5400 词，
       300 词上限下根本发不出去，图片成了摆设。

       这里改成：图片压缩成 WebP 后暂存，正文里只写一个短标记
       #wl-img-N，提交那一刻再拦 fetch 把标记展开成完整数据。
       于是编辑框干干净净，删掉一个标记就等于删掉整张图。 */

    const TOKEN = "#wl-img-";
    const STORE_KEY = "waline:img-store";

    const opts = {
      maxBytes: (imageOptions.maxSizeMB ?? 10) * 1024 * 1024,
      maxSide: imageOptions.maxSide ?? 1600,
      quality: imageOptions.quality ?? 0.82,
      targetBytes: (imageOptions.maxOutputKB ?? 300) * 1024,
    };

    /** id -> dataURL */
    const store = new Map();
    let seq = 0;

    // 刷新页面后还能接着提交：把没发出去的图存进 sessionStorage
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORE_KEY) || "{}");
      for (const [key, value] of Object.entries(saved)) {
        const id = Number(key);
        if (Number.isFinite(id) && typeof value === "string") {
          store.set(id, value);
          seq = Math.max(seq, id);
        }
      }
    } catch {}

    const persist = () => {
      try {
        sessionStorage.setItem(STORE_KEY, JSON.stringify(Object.fromEntries(store)));
      } catch {}
    };

    /** 用 <img> 解码，比 createImageBitmap 兼容性更好 */
    function decode(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          resolve(img);
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error("这张图片解码失败了，换一张或先转成 JPG 试试"));
        };
        img.src = url;
      });
    }

    /** 按指定长边和画质压一次 */
    function encode(img, maxSide, quality) {
      const scale = Math.min(1, maxSide / Math.max(img.naturalWidth, img.naturalHeight));
      const canvas = document.createElement("canvas");
      canvas.width = Math.max(1, Math.round(img.naturalWidth * scale));
      canvas.height = Math.max(1, Math.round(img.naturalHeight * scale));
      const ctx = canvas.getContext("2d");
      if (!ctx) return Promise.resolve(null);
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      return new Promise((resolve) => canvas.toBlob(resolve, "image/webp", quality));
    }

    function toDataUrl(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    /** Waline 的 imageUploader，返回的字符串会被原样插进 ![]( ) */
    async function uploadImage(file) {
      if (!file.type.startsWith("image/")) throw new Error("只能上传图片文件");
      if (file.size > opts.maxBytes) {
        throw new Error(`图片超过 ${imageOptions.maxSizeMB ?? 10}MB，先裁一下再传吧`);
      }

      let blob = file;

      // GIF 压成 WebP 会丢掉动画，SVG 会被光栅化，这两种保留原样
      const keepRaw = /^image\/(gif|svg\+xml)$/i.test(file.type);
      if (!keepRaw) {
        const img = await decode(file);
        // 逐级降质，压到目标体积就停
        const ladder = [
          [opts.maxSide, opts.quality],
          [Math.round(opts.maxSide * 0.85), opts.quality - 0.07],
          [Math.round(opts.maxSide * 0.7), opts.quality - 0.15],
          [Math.round(opts.maxSide * 0.55), opts.quality - 0.24],
        ];
        for (const [side, quality] of ladder) {
          const next = await encode(img, side, Math.max(0.42, quality));
          if (!next) break;
          blob = next;
          if (next.size <= opts.targetBytes) break;
        }
      }

      const id = ++seq;
      store.set(id, await toDataUrl(blob));
      persist();
      return `${TOKEN}${id}`;
    }

    /** 把正文里的短标记换回真正的图片数据 */
    const expand = (text) => text.replace(/#wl-img-(\d+)/g, (raw, id) => store.get(Number(id)) || raw);

    // 提交 / 编辑评论时展开标记。Waline v3 全部走 fetch，拦一层就够了。
    const nativeFetch = window.fetch.bind(window);
    window.fetch = function (input, init) {
      try {
        const method = (init?.method || "GET").toUpperCase();
        const url = typeof input === "string" ? input : input?.url || "";
        if (
          init &&
          typeof init.body === "string" &&
          (method === "POST" || method === "PUT") &&
          url.includes("/api/comment")
        ) {
          const body = expand(init.body);
          if (body !== init.body) init = { ...init, body };
        }
      } catch {}
      return nativeFetch(input, init);
    };

    // 预览区渲染时拿不到真实地址，等 DOM 更新后补上
    const patchPreview = () => {
      document.querySelectorAll('.wl-preview img[src^="#wl-img-"]').forEach((img) => {
        const real = store.get(Number(img.getAttribute("src").slice(TOKEN.length)));
        if (real) img.setAttribute("src", real);
      });
    };

    const requestedPath = new URLSearchParams(window.location.search).get("path");
    const effectiveConfig = requestedPath ? { ...config, path: requestedPath } : { ...config };
    if (imageOptions.enabled !== false) effectiveConfig.imageUploader = uploadImage;

    try {
      init(effectiveConfig);
      // Waline 是异步挂载的，等宿主就位后再观察预览区
      const host = document.getElementById("waline");
      if (host) new MutationObserver(patchPreview).observe(host, { childList: true, subtree: true });
    } catch (error) {
      console.error("[Waline] Failed to initialize:", error);
    }

    /* ── 评论图片点击放大 ─────────────────────────────────────────
       Waline v3 没有内置 lightbox，正文里的图只能看缩略。
       补一层：点击全屏查看，滚轮缩放（锚定鼠标位置）、拖拽平移、
       双击切换倍率、← → 切换同一条评论里的图、ESC 关闭。 */

    const LB_MIN = 1;
    const LB_MAX = 5;

    let lightbox = null;
    let lightboxImages = [];
    let lightboxIndex = 0;
    let lightboxScale = 1;
    let lightboxOffset = { x: 0, y: 0 };
    let dragStart = null;
    let dragEndAt = 0;
    let prevOverflow = "";

    const ICON = {
      close:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>',
      prev:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5L8 12l6.5 6.5"/></svg>',
      next:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 5.5L16 12l-6.5 6.5"/></svg>',
    };

    function clampOffset() {
      const img = lightbox.querySelector(".wl-lightbox__img");
      if (!img) return;
      // 放大后溢出的部分最多拖到这个范围，避免把图拖飞
      const maxX = Math.max(0, ((lightboxScale - 1) * img.offsetWidth) / 2);
      const maxY = Math.max(0, ((lightboxScale - 1) * img.offsetHeight) / 2);
      lightboxOffset.x = Math.min(maxX, Math.max(-maxX, lightboxOffset.x));
      lightboxOffset.y = Math.min(maxY, Math.max(-maxY, lightboxOffset.y));
    }

    function applyTransform() {
      const img = lightbox.querySelector(".wl-lightbox__img");
      img.style.transform = `translate3d(${lightboxOffset.x}px, ${lightboxOffset.y}px, 0) scale(${lightboxScale})`;
      img.classList.toggle("is-zoomed", lightboxScale > LB_MIN + 0.001);

      const zoom = lightbox.querySelector(".wl-lightbox__zoom");
      const visible = lightboxScale > LB_MIN + 0.001;
      zoom.textContent = visible ? `${Math.round(lightboxScale * 100)}%` : "";
      zoom.classList.toggle("is-visible", visible);
    }

    /** 以 (clientX, clientY) 为锚点缩放，鼠标下的那个点保持不动 */
    function zoomAt(clientX, clientY, factor) {
      const next = Math.min(LB_MAX, Math.max(LB_MIN, lightboxScale * factor));
      if (Math.abs(next - lightboxScale) < 0.001) return;

      const img = lightbox.querySelector(".wl-lightbox__img");
      const rect = img.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const ratio = next / lightboxScale;

      lightboxOffset.x -= (clientX - cx) * (ratio - 1);
      lightboxOffset.y -= (clientY - cy) * (ratio - 1);
      lightboxScale = next;
      if (lightboxScale <= LB_MIN + 0.001) lightboxOffset = { x: 0, y: 0 };
      clampOffset();
      applyTransform();
    }

    function bindLightboxEvents(box) {
      const img = box.querySelector(".wl-lightbox__img");

      img.addEventListener("pointerdown", (event) => {
        if (lightboxScale <= LB_MIN + 0.001) return;
        event.preventDefault();
        dragStart = {
          x: event.clientX,
          y: event.clientY,
          ox: lightboxOffset.x,
          oy: lightboxOffset.y,
        };
        img.classList.add("is-dragging");
        img.setPointerCapture(event.pointerId);
      });

      img.addEventListener("pointermove", (event) => {
        if (!dragStart) return;
        lightboxOffset.x = dragStart.ox + (event.clientX - dragStart.x);
        lightboxOffset.y = dragStart.oy + (event.clientY - dragStart.y);
        clampOffset();
        applyTransform();
      });

      const endDrag = (event) => {
        if (!dragStart) return;
        dragStart = null;
        dragEndAt = Date.now();
        img.classList.remove("is-dragging");
        try {
          img.releasePointerCapture(event.pointerId);
        } catch {}
      };
      img.addEventListener("pointerup", endDrag);
      img.addEventListener("pointercancel", endDrag);

      // 双击在 1x 和 2.5x 之间切换
      img.addEventListener("dblclick", (event) => {
        event.preventDefault();
        zoomAt(event.clientX, event.clientY, lightboxScale > LB_MIN + 0.001 ? 1 / lightboxScale : 2.5);
      });
    }

    function buildLightbox() {
      if (lightbox) return lightbox;
      const box = document.createElement("div");
      box.className = "wl-lightbox";
      box.setAttribute("aria-hidden", "true");
      box.innerHTML = [
        `<button class="wl-lightbox__btn wl-lightbox__close" type="button" aria-label="关闭">${ICON.close}</button>`,
        '<span class="wl-lightbox__count"></span>',
        '<span class="wl-lightbox__zoom"></span>',
        `<button class="wl-lightbox__btn wl-lightbox__nav" type="button" data-dir="prev" aria-label="上一张">${ICON.prev}</button>`,
        '<img class="wl-lightbox__img" alt="" draggable="false" />',
        `<button class="wl-lightbox__btn wl-lightbox__nav" type="button" data-dir="next" aria-label="下一张">${ICON.next}</button>`,
      ].join("");
      document.body.appendChild(box);
      lightbox = box;
      bindLightboxEvents(box);
      return box;
    }

    function renderLightbox() {
      const img = lightbox.querySelector(".wl-lightbox__img");
      const current = lightboxImages[lightboxIndex];
      lightboxScale = 1;
      lightboxOffset = { x: 0, y: 0 };
      img.src = current.src;
      img.alt = current.alt || "";
      applyTransform();

      lightbox.querySelector(".wl-lightbox__count").textContent =
        lightboxImages.length > 1 ? `${lightboxIndex + 1} / ${lightboxImages.length}` : "";
      for (const nav of lightbox.querySelectorAll(".wl-lightbox__nav")) {
        nav.hidden = lightboxImages.length < 2;
      }
    }

    function openLightbox(target) {
      buildLightbox();
      const content = target.closest(".wl-content");
      lightboxImages = content
        ? [...content.querySelectorAll("img")].filter((el) => !el.classList.contains("wl-emoji"))
        : [target];
      lightboxIndex = Math.max(0, lightboxImages.indexOf(target));
      renderLightbox();
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      prevOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = prevOverflow;
    }

    function stepLightbox(delta) {
      if (lightboxImages.length < 2) return;
      lightboxIndex = (lightboxIndex + delta + lightboxImages.length) % lightboxImages.length;
      renderLightbox();
    }

    // 打开和关闭放在同一个监听里：拆成两个的话，打开后会被第二个立即关掉
    document.addEventListener("click", (event) => {
      const el = event.target instanceof Element ? event.target : null;
      if (!el) return;

      if (lightbox?.classList.contains("is-open")) {
        const nav = el.closest(".wl-lightbox__nav");
        if (nav) {
          stepLightbox(nav.dataset.dir === "next" ? 1 : -1);
          return;
        }
        if (el.closest(".wl-lightbox__close")) {
          closeLightbox();
          return;
        }
        if (el.closest(".wl-lightbox__img")) return;
        // 刚拖完松手也会冒一个 click，别把它当成"点空白关闭"
        if (Date.now() - dragEndAt < 300) return;
        closeLightbox();
        return;
      }

      const img = el.closest("img");
      if (!img || !img.closest("#waline .wl-content")) return;
      event.preventDefault();
      openLightbox(img);
    });

    document.addEventListener(
      "wheel",
      (event) => {
        if (!lightbox?.classList.contains("is-open")) return;
        if (!(event.target instanceof Element) || !event.target.closest(".wl-lightbox__img")) return;
        event.preventDefault();
        zoomAt(event.clientX, event.clientY, event.deltaY < 0 ? 1.15 : 1 / 1.15);
      },
      { passive: false },
    );

    document.addEventListener("keydown", (event) => {
      if (!lightbox?.classList.contains("is-open")) return;
      if (event.key === "Escape") closeLightbox();
      else if (event.key === "ArrowLeft") stepLightbox(-1);
      else if (event.key === "ArrowRight") stepLightbox(1);
      else if (event.key === "0") {
        lightboxScale = 1;
        lightboxOffset = { x: 0, y: 0 };
        applyTransform();
      }
    });
  </script>
</div>

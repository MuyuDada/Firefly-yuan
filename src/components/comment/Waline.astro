---
import { commentConfig } from "@/config";
import "@/styles/components/waline.css";

interface Props {
	path: string;
}

const props = Astro.props;
// 这两个是本项目自定义的配置项，不进 Waline 的 init
const {
	requiredMeta: globalRequiredMeta,
	requiredMetaForFriends: friendsRequiredMeta,
	...walineOptions
} = commentConfig.waline ?? {};

// 友链页的评论是申请单，单独要求填昵称和邮箱
const isApplyPage = props.path.replace(/\/+$/, "") === "/friends";
const requiredMeta = isApplyPage
	? (friendsRequiredMeta ?? [])
	: (globalRequiredMeta ?? []);

const config = {
	...walineOptions,
	el: "#waline",
	path: props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(requiredMeta.length ? { requiredMeta } : {}),
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config }}>
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    const effectiveConfig = requestedPath
      ? { ...config, path: requestedPath }
      : config;
    try {
      init(effectiveConfig);
    } catch (error) {
      console.error("[Waline] Failed to initialize:", error);
    }
  </script>
</div>

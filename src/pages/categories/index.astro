---
import CategoryRose from "@components/widget/CategoryRose.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getTagGraphData } from "@/utils/content-utils";
import "@/styles/pages/common.css";
import "@/styles/pages/categories.css";

const categories = await getCategoryList();
const tagGraph = await getTagGraphData();

const title = i18n(I18nKey.categoriesTagsPage);
const subtitle = i18n(I18nKey.categoriesTagsSubtitle);
const articleUnit = i18n(I18nKey.postsCount);
const totalPosts = categories.reduce((sum, c) => sum + c.count, 0);
---

<MainGridLayout title={title} description={subtitle}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面标题 -->
      <header class="categories-page__section-header mb-6">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:donut-large" />
          </div>
          <div>
            <h2>{title}</h2>
            <p>{subtitle}</p>
          </div>
        </div>
      </header>

      <!-- 分类玫瑰图 -->
      {
        categories.length > 0 ? (
          <>
            <div class="categories-page__section-header">
              <div>
                <h2 class="categories-page__section-title">
                  {i18n(I18nKey.categoryRoseTitle)}
                </h2>
                <p class="categories-page__section-meta">
                  {categories.length} {i18n(I18nKey.categories)} · {totalPosts}{" "}
                  {articleUnit}
                </p>
              </div>
            </div>
            <CategoryRose categories={categories} articleUnit={articleUnit} />
          </>
        ) : (
          <div class="categories-page__empty">{i18n(I18nKey.noData)}</div>
        )
      }

      <div class="categories-page__divider" />

      <!-- 标签关系图 -->
      {
        tagGraph.nodes.length > 0 ? (
          <TagGraph
            graph={tagGraph}
            cooccurLabel={i18n(I18nKey.cooccurLabel)}
            articleUnit={articleUnit}
          />
        ) : (
          <div class="categories-page__empty">{i18n(I18nKey.noData)}</div>
        )
      }
    </div>
  </div>
</MainGridLayout>

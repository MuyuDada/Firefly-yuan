---
import MusicVisualizer from "@components/features/music-visualizer/MusicVisualizer.svelte";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import Layout from "@layouts/Layout.astro";
import { navbarMode, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/pages/music-visualizer.css";

if (!siteConfig.pages.music) {
	return Astro.redirect("/404/");
}
---

<Layout
	title={`${i18n(I18nKey.music)} - ${i18n(I18nKey.musicVisualizer3D)}`}
	description={i18n(I18nKey.musicVisualizerDescription)}
>
	<HeaderTopRow
		navbarMode={navbarMode}
		navbarWidthFull={siteConfig.navbar.widthFull ?? false}
	/>
	<main id="swup-container" class="transition-swup-main">
		<h1 class="sr-only">{`${i18n(I18nKey.music)} ${i18n(I18nKey.musicVisualizer3D)}`}</h1>
		<div class="music-visualizer-page">
			<MusicVisualizer client:only="svelte" />
		</div>
	</main>
</Layout>

				const label = dateFormatter.format(date);
				if (detailMode === "weekly") {
					detail.textContent = count ? `${label} 起这一周 · ${count} 次${noun}` : `${label} 起这一周 · 没有${noun}记录`;
					return;
				}
				if (detailMode === "cumulative") {
					detail.textContent = `${label} · 累计 ${count} 次${noun}`;

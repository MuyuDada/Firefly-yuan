				const activeCells = cells
					.filter((cell) => cell.dataset.pushActive === "true")
					.sort((a, b) => Number(a.dataset.pushRhythmOrder || 0) - Number(b.dataset.pushRhythmOrder || 0));
				const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
				const animationClock = getAnimationClock();
				const startedAt = animationClock.start();
				const generationEnd = 0.38;
				const rhythmEnd = 0.76;
				let snakeStarted = false;
				const setCellReveal = (cell, reveal) => {
					const easedReveal = reveal <= 0 ? 0 : 0.5 - Math.cos(reveal * Math.PI) / 2;
					cell.style.setProperty("--push-cell-reveal", easedReveal.toFixed(3));
					cell.style.setProperty("--push-cell-scale", (0.72 + easedReveal * 0.28).toFixed(3));
				};
				const finish = () => {
					cells.forEach((cell) => {
						setCellReveal(cell, 1);
						cell.dataset.pushRhythmState = cell.dataset.pushActive === "true" ? "lit" : "idle";
						cell.classList.remove("is-push-rhythm-active");
						cell.style.removeProperty("--push-rhythm-pulse");
					});
					heatmapGrid.dataset.pushAnimationPhase = "complete";
					snake.setRevealProgress(1);
					snake.start();
					pushAnimationFrame = 0;
				};

				heatmapGrid.dataset.pushAnimationPhase = reducedMotion ? "complete" : "generating";
				cells.forEach((cell) => {
					cell.dataset.pushRhythmState = cell.dataset.pushActive === "true" ? "pending" : "idle";
					cell.style.setProperty("--push-cell-base-opacity", cell.dataset.level === "future" ? "0.22" : "1");
					cell.style.removeProperty("--push-rhythm-pulse");
					cell.classList.remove("is-push-rhythm-active");
					setCellReveal(cell, reducedMotion ? 1 : 0);
				});
				snake.setRevealProgress(reducedMotion ? 1 : 0);
				if (reducedMotion) {

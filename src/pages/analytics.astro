				grid.style.setProperty("--push-snake-opacity", progress.toFixed(3));
			};
			const renderSnake = () => {
				clearVisuals();
				const snakeSet = new Set(snake);
				cells.forEach((cell, index) => {
					const baseLabel = cell.dataset.snakeBaseAriaLabel || "";
					const isEmptyCell = !cell.disabled && cell.dataset.level === "0";
					const isFood = isEmptyCell && food.has(index);
					const isSnake = isEmptyCell && snakeSet.has(index);
					const snakeSegment = isSnake ? snake.indexOf(index) : -1;
					if (isFood) {
						cell.classList.add("is-push-snake-food");
						if (targetFood === index) cell.classList.add("is-push-snake-food-target");
					}
					if (isSnake) {
						cell.classList.add("is-push-snake");
						const fade = snake.length > 1 ? Math.round((snakeSegment / (snake.length - 1)) * 68) : 0;
						cell.style.setProperty("--push-snake-fade", `${fade}%`);
					}
					if (snake[0] === index) cell.classList.add("is-push-snake-head");
					const decoration = isFood ? targetFood === index ? "，已锁定的贪吃蛇食物" : "，贪吃蛇食物" : isSnake ? "，贪吃蛇经过" : "";
					cell.setAttribute("aria-label", `${baseLabel}${decoration}`);
					cell.title = `${baseLabel}${decoration}`;
				});
				grid.dataset.snakeFoodCount = String(food.size);
				grid.dataset.snakeLength = String(snake.length);
			};
			const spawnFood = () => {
				const available = [...emptyCells].filter((index) => !food.has(index) && !snake.includes(index));
				if (!available.length) return false;
				food.add(randomItem(available));
				return true;
			};
			const getNeighbours = (index) => {
				const column = Math.floor(index / rows);
				const row = index % rows;
				const columnCount = Math.max(1, Math.ceil(cells.length / rows));
				return [
					[column - 1, row],
					[column + 1, row],
					[column, row - 1],
					[column, row + 1],
				]
					.filter(([nextColumn, nextRow]) => nextColumn >= 0 && nextColumn < columnCount && nextRow >= 0 && nextRow < rows)
					.map(([nextColumn, nextRow]) => nextColumn * rows + nextRow)
					.filter((nextIndex) => emptyCells.has(nextIndex));
			};
			const createInitialSnake = () => {
				const heads = [...emptyCells].sort(() => Math.random() - 0.5);
				for (const head of heads) {
					const necks = getNeighbours(head).sort(() => Math.random() - 0.5);
					for (const neck of necks) {
						const tails = getNeighbours(neck).filter((index) => index !== head).sort(() => Math.random() - 0.5);
						if (tails.length) return [head, neck, tails[0]];
					}
				}
				return heads.length ? [heads[0]] : [];
			};
			const fillFood = () => {
				while (food.size < maxFood && spawnFood()) {}
			};

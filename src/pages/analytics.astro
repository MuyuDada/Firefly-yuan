				setText(statElements.day, peakDay >= 0 && dayTotals[peakDay] > 0 ? weekdayLabels[peakDay] : "—");
				setText(statElements.night, totalValue > 0 ? `${Math.round((nightValue / totalValue) * 100)}%` : "—");
				if (note) note.textContent = statusText;

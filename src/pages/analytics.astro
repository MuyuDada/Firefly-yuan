		};

		const renderPushHeatmap = (panel, timestamps, noun = "推送", mode = "daily", heatmapWeeks = 53) => {
			const grid = panel.querySelector("[data-push-heatmap-grid]");
			const months = panel.querySelector("[data-push-heatmap-months]");
			const heatmapScroll = panel.querySelector("[data-push-heatmap-scroll]");
			const detail = panel.querySelector("[data-push-heatmap-detail]");
			if (!grid || !months) return;

			const todayParts = Object.fromEntries(datePartsFormatter.formatToParts(new Date()).map((part) => [part.type, part.value]));
			const today = new Date(Date.UTC(Number(todayParts.year), Number(todayParts.month) - 1, Number(todayParts.day), 12));
			const todayKey = dateKey(today);
			const currentWeekStart = new Date(today);
			currentWeekStart.setUTCDate(currentWeekStart.getUTCDate() - currentWeekStart.getUTCDay());
			const gridStyles = getComputedStyle(grid);
			const scrollStyles = heatmapScroll ? getComputedStyle(heatmapScroll) : null;
			const rootFontSize = parseFloat(gridStyles.fontSize) || 16;
			const heatmapGap = parseFloat(gridStyles.columnGap) || rootFontSize * 0.16;
			const minimumCellSize = rootFontSize * 0.56;
			const availableWidth = Math.max(
				0,
				(heatmapScroll?.clientWidth || grid.clientWidth || panel.clientWidth) -
					(parseFloat(scrollStyles?.paddingLeft) || 0) -
					(parseFloat(scrollStyles?.paddingRight) || 0),
			);
			const minimumGridWidth = minimumCellSize * heatmapWeeks + heatmapGap * (heatmapWeeks - 1);
			const gridWidth = Math.max(availableWidth, minimumGridWidth);
			const cellSize = (gridWidth - heatmapGap * (heatmapWeeks - 1)) / heatmapWeeks;
			const firstDay = new Date(currentWeekStart);

					<div class="analytics-region-card__body">
						<div class="analytics-region-card__map-wrap">
							<div class="analytics-region-card__map" data-region-map role="img" aria-label="中国省级访客地域分布图">
								<img
									class="analytics-region-card__map-image"
									data-region-map-image
									src="/images/china-blank-province-map.svg"
									alt="中国省级行政区边界图"
									loading="lazy"
									decoding="async"
								/>
								<svg class="analytics-region-card__map-overlay" data-region-map-overlay viewBox="0 0 1000 850" aria-hidden="true">
									<g data-region-map-base-fills></g>

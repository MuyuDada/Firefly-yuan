				cell.setAttribute("aria-label", `${label}${mode === "daily" ? "" : " 这一周"}：${isFuture ? "尚未到达" : count ? `${count} 次${noun}` : `没有${noun}记录`}${stateLabel}`);
				cell.title = cell.getAttribute("aria-label");
				cell.disabled = isFuture;

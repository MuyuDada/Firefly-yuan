			for (let week = 0; week < heatmapWeeks; week += 1) {
				const weekStart = new Date(firstDay);
				weekStart.setUTCDate(firstDay.getUTCDate() + week * 7);
				const previousWeekStart = week > 0 ? new Date(firstDay) : null;
				if (previousWeekStart) previousWeekStart.setUTCDate(firstDay.getUTCDate() + (week - 1) * 7);
				if (week === 0 || monthFormatter.format(weekStart) !== monthFormatter.format(previousWeekStart)) {
					const monthLabel = document.createElement("span");
					monthLabel.textContent = monthFormatter.format(weekStart);
					monthLabel.style.gridColumn = String(week + 1);
					if (week === heatmapWeeks - 1) {
						monthLabel.style.transform = "translateX(-100%)";
						monthLabel.style.textAlign = "right";
					}
					months.append(monthLabel);
				}

				if (mode === "daily") {
					for (let weekday = 0; weekday < 7; weekday += 1) {
						const date = new Date(weekStart);
						date.setUTCDate(weekStart.getUTCDate() + weekday);
						const count = counts.get(dateKey(date)) || 0;
						appendCell(date, count, date > today, dateKey(date) === todayKey, null, "", week * 7 + weekday);
					}
					continue;
				}

				const weeklyCount = weekCounts.get(dateKey(weekStart)) || 0;
				cumulativeCount += weeklyCount;
				const periodCount = mode === "cumulative" ? cumulativeCount : weeklyCount;
				const activeRows = mode === "weekly"
					? maxWeeklyCount ? Math.ceil((weeklyCount / maxWeeklyCount) * 7) : 0
					: totalCount ? Math.ceil((cumulativeCount / totalCount) * 7) : 0;
				for (let row = 0; row < 7; row += 1) {
					const isFilled = row >= 7 - activeRows;
					appendCell(weekStart, isFilled ? periodCount : 0, false, week === heatmapWeeks - 1, isFilled ? 4 : 0, isFilled ? "，有推送" : "，无推送", week * 7 + (6 - row));
				}
			}

			const currentWeekKey = dateKey(currentWeekStart);
			const currentWeekCount = weekCounts.get(currentWeekKey) || 0;
			const currentCumulativeCount = [...weekCounts.entries()]
				.filter(([key]) => key <= currentWeekKey)
				.reduce((sum, [, count]) => sum + count, 0);
			setDetail(mode === "daily" ? today : currentWeekStart, mode === "daily" ? counts.get(todayKey) || 0 : mode === "weekly" ? currentWeekCount : currentCumulativeCount);
		};


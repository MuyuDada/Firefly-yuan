				for (const cleanup of cleanups.splice(0)) cleanup();
				runtime.activeRoot = null;
			};

			const localHost = ["localhost", "127.0.0.1", "::1", "0.0.0.0"].includes(window.location.hostname.toLowerCase());
			const isLocal = localHost || window.location.protocol === "file:" || document.documentElement.dataset.analyticsMode === "local";
			cleanups.push(setupAnalyticsFooter(root));
			cleanups.push(setupPushRhythm(root));
			cleanups.push(setupDomesticRegion(root, apiBase, shareId));
			root.classList.toggle("is-local-preview", isLocal);
			if (!hasPublicStats || !apiBase || !shareId) {
				setStatus(root, "offline", "未配置");
				root.querySelector("[data-analytics-last-update]").textContent = "尚未配置公开分享数据";
				renderTrafficSources(root, [], range);
				cleanups.push(setupVisitorActivity(root, apiBase, shareId));
				cleanups.push(setupRecentComments(root));
				return;
			}
			cleanups.push(setupVisitorActivity(root, apiBase, shareId));
			cleanups.push(setupRecentComments(root));

			const updateRangeButtons = () => rangeButtons.forEach((button) => button.setAttribute("aria-pressed", String(Number(button.dataset.range) === range)));
			const refresh = async (forceRefresh = false) => {
				if (refreshInFlight) return;
				refreshInFlight = true;
				chartCleanup?.(!forceRefresh);
				chartCleanup = undefined;
				controller?.abort();
				controller = new AbortController();
				root.classList.add("is-loading");
				setStatus(root, "loading", "读取中");
				if (refreshButton) refreshButton.disabled = true;
				const endAt = Date.now();
				const startAt = endAt - range * 24 * 60 * 60 * 1000;
				const cacheKey = getCacheKey(shareId, range);
				try {
					const cached = forceRefresh ? null : readCache(cacheKey);
					let requests;
					if (cached) {
						requests = {
							traffic: Promise.resolve(cached.pageviews),
							ranking: Promise.resolve(cached.paths),
						};
						if (cached.sources !== undefined) requests.sources = Promise.resolve(cached.sources);
					} else {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
						const buildUrl = (path, params = {}) => {
							const url = new URL(`${apiBase}/api/websites/${share.websiteId}/${path}`);
							url.searchParams.set("startAt", String(startAt));
							url.searchParams.set("endAt", String(endAt));
							Object.entries(params).forEach(([key, value]) => url.searchParams.set(key, String(value)));
							return url;
						};
						requests = {
							traffic: fetchJson(buildUrl("pageviews", { unit: "day", timezone: timeZone }), { headers, signal: controller.signal }),
							ranking: fetchJson(buildUrl("metrics", { type: "path", limit: 20 }), { headers, signal: controller.signal }),
							sources: fetchJson(buildUrl("metrics", { type: "channel", limit: 500 }), { headers, signal: controller.signal }),
						};
					}
					if (!requests.sources) {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
						const url = new URL(`${apiBase}/api/websites/${share.websiteId}/metrics`);
						url.searchParams.set("startAt", String(startAt));
						url.searchParams.set("endAt", String(endAt));
						url.searchParams.set("type", "channel");
						url.searchParams.set("limit", "500");
						requests.sources = fetchJson(url, { headers, signal: controller.signal });
					}

					const sections = [
						{
							key: "traffic",
							request: requests.traffic,
							render: (payload) => {
								const pageviews = readRows(payload?.pageviews);
								const sessions = readRows(payload?.sessions);
								chartCleanup?.();
								chartCleanup = drawChart(root, pageviews, sessions, range);
							},
							fallback: () => showChartMessage(root, "趋势暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "ranking",
							request: requests.ranking,
							render: (payload) => renderRanking(root, readRows(payload)),
							fallback: () => showRankingMessage(root, "热门页面暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "sources",
							request: requests.sources,
							render: (payload) => renderTrafficSources(root, readRows(payload), range),
							fallback: () => renderTrafficSources(root, [], range),
						},
					];
					const successful = new Set();
					const failed = new Set();
					const updateProgress = () => {
						if (successful.size > 0 && failed.size === 0 && successful.size === sections.length) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 已更新" : "在线");
							root.querySelector("[data-analytics-last-update]").textContent = `${isLocal ? "本地预览刚刚更新" : "刚刚更新"} · ${range} 天区间`;
						} else if (successful.size > 0) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 部分更新" : "部分在线");
							root.querySelector("[data-analytics-last-update]").textContent = `已更新 ${successful.size}/${sections.length} 个模块`;
						}
					};
					const settleSection = async (section) => {
						try {
							return { status: "fulfilled", payload: await section.request };
						} catch (error) {
							return { status: "rejected", error };
						}
					};
					const applySectionResult = (section, result) => {
						if (result.status === "fulfilled") {
							section.render(result.payload);
							successful.add(section.key);
						} else {
							if (result.error?.name === "AbortError") return;
							failed.add(section.key);
							section.fallback();
						}
						updateProgress();
					};

					if (forceRefresh) {
						const results = await Promise.all(sections.map(settleSection));
						if (results.some((result) => result.status === "fulfilled" || result.error?.name !== "AbortError")) {
							replayAnalyticsAnimations();
							results.forEach((result, index) => applySectionResult(sections[index], result));
						}
					} else {
						await Promise.all(sections.map(async (section) => {
							applySectionResult(section, await settleSection(section));
						}));
					}

					if (!cached && successful.size === sections.length) {
						writeCache(cacheKey, {
							pageviews: await requests.traffic,
							paths: await requests.ranking,
							sources: await requests.sources,
						});
					}
					if (successful.size === 0 && failed.size > 0) {
						setStatus(root, "offline", "暂不可用");
						root.querySelector("[data-analytics-last-update]").textContent = "公开接口暂时没有响应 · 可稍后重试";
						renderTrafficSources(root, [], range);
					}
				} catch (error) {
					if (error?.name !== "AbortError") {
						setStatus(root, "offline", "暂不可用");
						root.querySelector("[data-analytics-last-update]").textContent = "公开接口暂时没有响应 · 可稍后重试";
						showUnavailableSections(root, "公开数据接口响应较慢，请稍后刷新重试。");
						renderTrafficSources(root, [], range);
					}
				} finally {
					refreshInFlight = false;
					root.classList.remove("is-loading");
					if (refreshButton) refreshButton.disabled = false;
				}
			};

			for (const button of rangeButtons) {
				const onClick = () => {
					range = Number(button.dataset.range) || 30;
					updateRangeButtons();
					refresh();
				};
				button.addEventListener("click", onClick);
				cleanups.push(() => button.removeEventListener("click", onClick));
			}
			if (refreshButton) {
				const onRefresh = () => refresh(true);
				refreshButton.addEventListener("click", onRefresh);
				cleanups.push(() => refreshButton.removeEventListener("click", onRefresh));
			}
			updateRangeButtons();
			refresh();
		};

		if (!runtime.bound) {
			for (const eventName of ["astro:page-load", "astro:after-swap", "swup:contentReplaced", "swup:page:view"]) {
				document.addEventListener(eventName, setup);
			}
			runtime.bound = true;
		}
		window[runtimeKey] = runtime;
		setup();
	})();
</script>

</MainGridLayout>


				food = new Set();
				targetFood = null;
				fillFood();
				renderSnake();
			};
			const endRound = () => {
				const currentRound = round;
				snake = [];
				food = new Set();
				targetFood = null;
				renderSnake();
				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => {
					if (currentRound === round) startRound();
				}, 420);
			};
			const nextCell = () => {
				if (!snake.length) return null;
				const head = snake[0];
				const blocked = new Set(snake);
				const queue = [{ index: head, firstStep: null }];
				const visited = new Set([head]);
				const targets = targetFood !== null && food.has(targetFood) ? new Set([targetFood]) : food;
				while (queue.length) {
					const current = queue.shift();
					for (const neighbour of getNeighbours(current.index)) {
						if (visited.has(neighbour) || blocked.has(neighbour)) continue;
						const firstStep = current.firstStep ?? neighbour;
						if (targets.has(neighbour)) return firstStep;
						visited.add(neighbour);
						queue.push({ index: neighbour, firstStep });
					}
				}
				if (targetFood !== null && food.has(targetFood)) {
					targetFood = null;
					return nextCell();
				}

				const fallback = getNeighbours(head);
				const safeFallback = fallback.filter((index) => !blocked.has(index));
				if (safeFallback.length) return randomItem(safeFallback);
				return fallback.length ? randomItem(fallback) : null;
			};
			const extendSnake = (amount) => {
				for (let segment = 1; segment < amount; segment += 1) {
					const tail = snake[snake.length - 1];
					const neck = snake[snake.length - 2];
					const available = getNeighbours(tail).filter((index) => !snake.includes(index) && !food.has(index));
					if (!available.length) return false;
					const tailColumn = Math.floor(tail / rows);
					const tailRow = tail % rows;
					const neckColumn = Math.floor(neck / rows);
					const neckRow = neck % rows;
					const preferredColumn = tailColumn + (tailColumn - neckColumn);
					const preferredRow = tailRow + (tailRow - neckRow);
					const preferred = preferredColumn * rows + preferredRow;

						<div class="analytics-region-card__ranking">
							<p>TOP 5 省区</p>
							<ol data-region-list aria-live="polite">
								{Array.from({ length: 5 }, () => (
									<li class="analytics-region-card__item analytics-region-card__item--skeleton"><i></i><span></span><strong></strong></li>
								))}
							</ol>

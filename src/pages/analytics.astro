				counts.set(dayKey, adjustedCount);
				localDay.setUTCDate(localDay.getUTCDate() - localDay.getUTCDay());
				const weekKey = dateKey(localDay);
				weekCounts.set(weekKey, (weekCounts.get(weekKey) || 0) + adjustedCount);
			}


					const value = Number(cell.dataset.activityValue) || 0;
					const weekday = Number(cell.dataset.weekday);
					const hour = Number(cell.dataset.hour);
					if (note) note.textContent = `${weekdayLabels[weekday]} ${String(hour).padStart(2, "0")}:00 · ${formatNumber(value)} 次访问`;
				};
				cell.addEventListener("pointerenter", showDetail);
				cell.addEventListener("focus", showDetail);
				cell.addEventListener("pointerleave", resetDetail);
				cell.addEventListener("blur", resetDetail);
			});

			const load = async () => {
				if (!apiBase || !shareId) {
					renderActivity([], "尚未配置公开分享数据");
					return;
				}
				try {
					const share = await fetchShare(apiBase, shareId, controller.signal);
					const endAt = Date.now();
					const startAt = endAt - 30 * 24 * 60 * 60 * 1000;
					const url = new URL(`${apiBase}/api/websites/${share.websiteId}/pageviews`);
					url.searchParams.set("startAt", String(startAt));
					url.searchParams.set("endAt", String(endAt));
					url.searchParams.set("unit", "hour");
					url.searchParams.set("timezone", timeZone);
					const payload = await fetchJson(url, {
						headers: {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						},
						signal: controller.signal,
					}, 7000);
					const sessions = readRows(payload?.sessions);
					const pageviews = readRows(payload?.pageviews);
					renderActivity(sessions.length ? sessions : pageviews, sessions.length ? "按北京时间聚合近 30 天访客记录 · 鼠标移入查看具体时段" : "按北京时间聚合近 30 天访问记录 · 鼠标移入查看具体时段");
				} catch (error) {
					if (error?.name === "AbortError") return;
					renderActivity([], "小时级公开数据暂时不可用 · 可稍后刷新");
				}
			};

			const handleAnimationReplay = () => animateActivity();
			window.addEventListener("muyu-analytics-animation-replay", handleAnimationReplay);
			load();
			return () => {
				controller.abort();
				if (activityAnimationFrame) cancelAnimationFrame(activityAnimationFrame);
				window.removeEventListener("muyu-analytics-animation-replay", handleAnimationReplay);
				cells.forEach((cell) => {
					cell.replaceWith(cell.cloneNode(true));
				});
			};
		};

		const setup = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			if (!root) {
				clearRuntime();
				return;
			}
			if (runtime.activeRoot === root) return;
			clearRuntime();
			runtime.activeRoot = root;

			const apiBase = String(root.dataset.apiBase || "").replace(/\/+$/, "");
			const shareId = root.dataset.shareId || "";
			const rangeButtons = [...root.querySelectorAll("[data-range]")];
			const refreshButton = root.querySelector("[data-analytics-refresh]");
			const cleanups = [];
			let range = 30;
			let controller;
			let refreshInFlight = false;
			let chartCleanup;
			runtime.cleanup = () => {
				controller?.abort();

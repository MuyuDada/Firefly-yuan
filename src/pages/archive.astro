---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import ArchiveHeatmap from "@components/widget/ArchiveHeatmap.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "@/utils/content-utils";
import "@/styles/pages/common.css";
import "@/styles/components/archive-heatmap.css";
import "@/styles/components/archive-panel.css";

const sortedPostsList = await getSortedPostsList();
const title = i18n(I18nKey.archive);
const total = sortedPostsList.length;
---

<MainGridLayout title={title}>
  <div class="page-shell">
    <!-- 标题面板 -->
    <header class="card-base page-header mb-4">
      <div class="page-heading">
        <div class="page-icon" aria-hidden="true">
          <Icon name="material-symbols:calendar-month-rounded" />
        </div>
        <div>
          <h2>{title}</h2>
          <p>
            {total} {i18n(I18nKey.postsCount)}
          </p>
        </div>
      </div>
    </header>

    <!-- 双热力图 + 时间轴 -->
    <div class="card-base px-4 py-6 md:px-9 relative w-full">
      <ArchiveHeatmap posts={sortedPostsList} />
      <ArchivePanel />
    </div>
  </div>
</MainGridLayout>

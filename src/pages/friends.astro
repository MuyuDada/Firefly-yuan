---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import FriendCard from "@components/features/FriendCard.astro";
import FriendRulesModal from "@components/features/FriendRulesModal.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";
import "@/styles/components/friend-card.css";
import "@/styles/components/friend-rules-modal.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled = Boolean(
	commentConfig?.type &&
		commentConfig.type !== "none" &&
		friendsPageConfig.showComment !== false,
);

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);

// 分页参数（交给客户端脚本切片，这里只用于初始状态）
const pageSize = Math.max(1, friendsPageConfig.pageSize ?? 9);

// 申请弹窗是否渲染：applyLink / siteInfo / 评论区 三者之一满足即可
const hasApplyModal = Boolean(
	friendsPageConfig.applyLink || friendsPageConfig.siteInfo || isCommentEnabled,
);
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:group" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
        {hasApplyModal && <FriendRulesModal hasComment={isCommentEnabled} />}
      </div>

      <!-- 工具栏：搜索 + Tag 筛选 -->
      {
        items.length > 0 && (
          <friend-filter class="friend-toolbar">
            <div class="friend-toolbar-top">
              <div class="friend-search">
                <Icon
                  name="material-symbols:search"
                  class="friend-search-icon"
                />
                <input
                  type="text"
                  data-friend-search
                  placeholder={i18n(I18nKey.searchFriends)}
                  autocomplete="off"
                />
              </div>
            </div>
            <div class="friend-tabs" data-friend-tabs>
              <span class="friend-tab-indicator" data-tab-indicator aria-hidden="true" />
              <button data-tag="all" class="friend-tab-btn" data-active>
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button data-tag={tag} class="friend-tab-btn">
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <!-- 友链卡片网格 -->
      <div class="friends-grid" data-friends-grid>
        {items.length === 0 && (
          <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
            <Icon name="material-symbols:group-off-outline" class="text-4xl mb-3" />
            <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
          </div>
        )}
        {items.map((item) => <FriendCard friend={item} />)}
      </div>

      <!-- 分页 -->
      <nav
        class="friend-pagination"
        data-friend-pagination
        aria-label="Pagination"
        hidden
      />

      <!-- 筛选无结果提示 -->
      <div
        class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500"
        data-friends-empty
      >
        <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {
    friendsPageConfig.showCustomContent !== false && (
      <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
        <Markdown class="">
          <Content />
        </Markdown>
      </div>
    )
  }

  <!-- 评论区 -->
  {
    isCommentEnabled && (
      <div class="mt-4" id="friends-comment">
        <Comment post={friendsPost} customPath="/friends/" />
      </div>
    )
  }

  <script
    slot="head"
    is:inline
    define:vars={{
      pageSize,
      latencyTimeout: friendsPageConfig.latencyTimeout ?? 5000,
      latencyGoodMs: friendsPageConfig.latencyGoodMs ?? 2000,
      showLatency: friendsPageConfig.showLatency !== false,
    }}
  >
    (() => {
      const PAGE_SIZE = pageSize;
      const LATENCY_TIMEOUT = latencyTimeout;
      const LATENCY_GOOD_MS = latencyGoodMs;
      const SHOW_LATENCY = showLatency;

      // 每个卡片只探测一次延时，避免翻页/筛选回来重复请求
      const probed = new WeakSet();
      // 已加载的图片不重复赋值
      const loaded = new WeakSet();

      /** 探测单张卡片的访问延时（no-cors，只用于估算连通性） */
      async function probeLatency(card) {
        if (!SHOW_LATENCY || probed.has(card)) return;
        const badge = card.querySelector("[data-latency]");
        const badgeText = card.querySelector("[data-latency-text]");
        const target = card.dataset.siteurl;
        if (!badge || !target) return;
        probed.add(card);

        const started = performance.now();
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), LATENCY_TIMEOUT);

        const settle = (state, text) => {
          badge.classList.remove("is-pending");
          badge.classList.add(state);
          if (badgeText) badgeText.textContent = text;
        };

        try {
          await fetch(target, {
            mode: "no-cors",
            cache: "no-store",
            signal: controller.signal,
          });
          clearTimeout(timer);
          const ms = Math.round(performance.now() - started);
          settle(ms < LATENCY_GOOD_MS ? "is-good" : "is-warn", ms + " MS");
        } catch {
          clearTimeout(timer);
          settle("is-bad", badge.dataset.timeoutLabel || "Timeout");
        }
      }

      /** 懒加载卡片的头像与预览图，并在加载完成后给外层容器加状态类 */
      function loadImages(card) {
        card.querySelectorAll("img[data-src]").forEach((img) => {
          if (loaded.has(img)) return;
          loaded.add(img);

          const avatarWrap = img.closest(".friend-card-avatar");
          const previewWrap = img.closest(".friend-card-preview");

          img.addEventListener(
            "load",
            () => {
              avatarWrap?.classList.add("is-loaded");
              previewWrap?.classList.add("is-loaded");
            },
            { once: true },
          );
          img.addEventListener(
            "error",
            () => {
              // 头像失败时回退到首字占位
              avatarWrap?.classList.add("is-error");
            },
            { once: true },
          );

          img.src = img.dataset.src;
          img.removeAttribute("data-src");
        });
      }

      /** 卡片进入视口后再做重活（图片 + 延时探测） */
      function observeCards(cards) {
        if (!("IntersectionObserver" in window)) {
          cards.forEach((card) => {
            loadImages(card);
            probeLatency(card);
          });
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const card = entry.target;
              loadImages(card);
              probeLatency(card);
              io.unobserve(card);
            });
          },
          { rootMargin: "200px" },
        );
        cards.forEach((card) => io.observe(card));
      }

      /** 渲染分页按钮 */
      function renderPagination(host, total, currentPage, onGo) {
        const pages = Math.ceil(total / PAGE_SIZE);
        if (pages <= 1) {
          host.hidden = true;
          host.innerHTML = "";
          return;
        }
        host.hidden = false;

        const btn = (label, page, opts = {}) => {
          const el = document.createElement("button");
          el.type = "button";
          el.className = "friend-page-btn";
          el.textContent = label;
          if (opts.active) el.setAttribute("data-active", "");
          if (opts.disabled) el.disabled = true;
          if (!opts.disabled && !opts.active) {
            el.addEventListener("click", () => onGo(page));
          }
          return el;
        };

        const frag = document.createDocumentFragment();
        frag.appendChild(
          btn("‹", currentPage - 1, { disabled: currentPage === 1 }),
        );

        // 页码：首页、末页、当前页附近，其余折叠成省略号
        const windowSize = 1;
        const shown = new Set([1, pages, currentPage]);
        for (let i = 1; i <= windowSize; i++) {
          if (currentPage - i >= 1) shown.add(currentPage - i);
          if (currentPage + i <= pages) shown.add(currentPage + i);
        }
        const sorted = [...shown].sort((a, b) => a - b);

        let last = 0;
        for (const page of sorted) {
          if (last && page - last > 1) {
            const dots = document.createElement("span");
            dots.className = "friend-page-ellipsis";
            dots.textContent = "…";
            frag.appendChild(dots);
          }
          frag.appendChild(
            btn(String(page), page, { active: page === currentPage }),
          );
          last = page;
        }

        frag.appendChild(
          btn("›", currentPage + 1, { disabled: currentPage === pages }),
        );

        host.innerHTML = "";
        host.appendChild(frag);
      }

      /** 初始化整页交互 */
      function init() {
        const root = document.querySelector("[data-friends-grid]");
        if (!root) return;

        const filter = document.querySelector("friend-filter");
        const pagination = document.querySelector("[data-friend-pagination]");
        const emptyEl = document.querySelector("[data-friends-empty]");
        const allCards = [...root.querySelectorAll(".friend-card")];
        const searchInput = filter?.querySelector("[data-friend-search]");

        let activeTag = "all";
        let query = "";
        let currentPage = 1;
        let matched = allCards;

        function apply() {
          // 1. 过滤
          matched = allCards.filter((card) => {
            const tags = (card.dataset.tags || "").split(",");
            const tagOk =
              activeTag === "all" || tags.includes(activeTag);
            if (!tagOk) return false;
            if (!query) return true;
            const name = (
              card.querySelector(".friend-name")?.textContent || ""
            ).toLowerCase();
            const desc = (
              card.querySelector(".friend-desc")?.textContent || ""
            ).toLowerCase();
            const host = (
              card.querySelector(".friend-host")?.textContent || ""
            ).toLowerCase();
            const tagText = (card.dataset.tags || "").toLowerCase();
            return (
              name.includes(query) ||
              desc.includes(query) ||
              host.includes(query) ||
              tagText.includes(query)
            );
          });

          // 2. 过滤条件变化时回到第 1 页
          const pages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
          if (currentPage > pages) currentPage = 1;

          // 3. 只显示当前页
          const start = (currentPage - 1) * PAGE_SIZE;
          const pageCards = matched.slice(start, start + PAGE_SIZE);
          const pageSet = new Set(pageCards);
          allCards.forEach((card) => {
            card.style.display = pageSet.has(card) ? "" : "none";
          });

          // 4. 空结果提示
          if (emptyEl) {
            const noResult = matched.length === 0;
            emptyEl.classList.toggle("hidden", !noResult);
            emptyEl.classList.toggle("flex", noResult);
          }

          // 5. 分页按钮
          if (pagination) {
            renderPagination(pagination, matched.length, currentPage, (page) => {
              currentPage = page;
              apply();
              root.scrollIntoView({ behavior: "smooth", block: "start" });
            });
          }

          // 6. 新进入视口的卡片才加载资源
          observeCards(pageCards);
        }

        // 搜索：输入防抖
        if (searchInput) {
          let timer;
          searchInput.addEventListener("input", () => {
            clearTimeout(timer);
            timer = setTimeout(() => {
              query = searchInput.value.toLowerCase().trim();
              currentPage = 1;
              apply();
            }, 150);
          });
        }

        // Tag 筛选（配合滑动指示条）
        const tabsWrap = filter?.querySelector("[data-friend-tabs]");
        const indicator = filter?.querySelector("[data-tab-indicator]");

        /** 把指示条对齐到当前激活的 Tag 按钮（含纵向位置与高度） */
        function moveIndicator(button) {
          if (!indicator || !tabsWrap || !button) return;
          const wrapRect = tabsWrap.getBoundingClientRect();
          const btnRect = button.getBoundingClientRect();
          // 同时设置 top/height：标签换行后按钮可能落在第二行，
          // 只设 left/width 会让指示条停在第一行或横跨多行。
          indicator.style.left = btnRect.left - wrapRect.left + "px";
          indicator.style.top = btnRect.top - wrapRect.top + "px";
          indicator.style.width = btnRect.width + "px";
          indicator.style.height = btnRect.height + "px";
          indicator.style.opacity = "1";
        }

        filter?.addEventListener("click", (event) => {
          const button = event.target.closest("button[data-tag]");
          if (!button) return;
          activeTag = button.dataset.tag;
          filter
            .querySelectorAll("button[data-tag]")
            .forEach((b) => b.removeAttribute("data-active"));
          button.setAttribute("data-active", "");
          moveIndicator(button);
          currentPage = 1;
          apply();
        });

        apply();

        // 始终按"当前激活按钮"重新定位，避免持有过期的按钮引用
        const syncIndicator = () =>
          moveIndicator(filter?.querySelector("button[data-tag][data-active]"));

        syncIndicator();
        // 字体加载完宽度会变，需要重算一次
        document.fonts?.ready.then(syncIndicator);
        // 换行会随视口宽度变化，resize 后按钮可能落到另一行
        window.addEventListener("resize", syncIndicator);
      }

      // ── 申请弹窗 ──────────────────────────────
      function initModal() {
        // 清理上一次页面遗留在 body 上的弹窗节点（Swup 切页时可能残留）
        document
          .querySelectorAll("body > [data-modal-root]")
          .forEach((el) => el.remove());

        const modal = document.querySelector("friend-rules-modal");
        if (!modal) return;
        if (modal.dataset.friendsBound === "true") return;
        modal.dataset.friendsBound = "true";
        const root = modal.querySelector("[data-modal-root]");
        if (!root) return;

        // 弹窗必须挂在 body 上才能正确定位：
        // #content-wrapper 带有 transform（入场动画的 identity 矩阵），
        // 而任何 transform 都会让该元素成为 position:fixed 的包含块，
        // 导致弹窗按内容区而非视口居中，面板会被挤出屏幕底部。
        const anchor = document.createComment("friend-modal-anchor");
        root.parentNode.insertBefore(anchor, root);

        const open = () => {
          if (root.parentNode !== document.body) {
            document.body.appendChild(root);
          }
          root.hidden = false;
          document.body.classList.add("friend-modal-open");
        };
        const close = () => {
          root.hidden = true;
          document.body.classList.remove("friend-modal-open");
          // 归位，让节点跟随页面内容一起被 Swup 回收
          if (anchor.parentNode) {
            anchor.parentNode.insertBefore(root, anchor.nextSibling);
          }
        };

        modal.querySelector("[data-modal-open]")?.addEventListener("click", open);
        modal.querySelector("[data-modal-close]")?.addEventListener("click", close);
        modal.querySelector("[data-modal-backdrop]")?.addEventListener("click", close);
        modal.querySelector("[data-modal-comment]")?.addEventListener("click", () => {
          close();
          document
            .getElementById("friends-comment")
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !root.hidden) close();
        });

        // 一键复制（clipboard API 不可用时回退到 execCommand）
        const copiedLabel = modal.dataset.copiedLabel || "Copied";
        const copyText = async (text) => {
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(text);
              return true;
            }
          } catch {
            // 落到下面的兜底方案
          }
          try {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            // execCommand 已废弃，但作为 clipboard API 不可用（http 环境 / 旧浏览器）时的兜底仍必要
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return ok;
          } catch {
            return false;
          }
        };

        modal.querySelectorAll("[data-copy]").forEach((button) => {
          button.addEventListener("click", async () => {
            const ok = await copyText(button.dataset.copy || "");
            if (!ok) return;
            button.classList.add("is-copied");
            const original = button.getAttribute("aria-label");
            button.setAttribute("aria-label", copiedLabel);
            setTimeout(() => {
              button.classList.remove("is-copied");
              if (original) button.setAttribute("aria-label", original);
            }, 1500);
          });
        });
      }

      function boot() {
        const grid = document.querySelector("[data-friends-grid]");
        // 同一个 DOM 只初始化一次（Swup 换页后会产生新的网格节点）
        if (!grid || grid.dataset.friendsBound === "true") return;
        grid.dataset.friendsBound = "true";
        init();
        initModal();
      }

      // 本脚本位于 <head>，执行时 DOM 尚未解析完；且页面引入的第三方资源
      // （评论样式、统计脚本等）可能长时间阻塞 DOMContentLoaded，
      // 因此这里不能只依赖 DOMContentLoaded，改用 MutationObserver 等待网格出现。
      if (!window.__friendsPageInit) {
        window.__friendsPageInit = true;

        const startWatching = () => {
          boot();
          if (document.querySelector("[data-friends-grid]")) return;

          const observer = new MutationObserver(() => {
            if (!document.querySelector("[data-friends-grid]")) return;
            observer.disconnect();
            boot();
          });
          observer.observe(document.documentElement, {
            childList: true,
            subtree: true,
          });
        };

        if (document.readyState === "loading") {
          // DOMContentLoaded 作为快速路径；MutationObserver 兜底
          startWatching();
          document.addEventListener("DOMContentLoaded", boot, { once: true });
        } else {
          startWatching();
        }

        // Swup 切页后重新初始化
        document.addEventListener("astro:page-load", boot);
      } else {
        boot();
      }
    })();
  </script>
</MainGridLayout>
